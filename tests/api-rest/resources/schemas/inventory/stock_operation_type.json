{
    "type": "object",
    "required": [
        "id", "created_at", "name", "operation_code", "reservation_method",
        "backorder_policy", "etag", "is_archived", "org_id", "sequence_prefix",
        "warehouse_id"
    ],
    "properties": {
        "id": {
            "type": "string",
            "minLength": 1
        },
        "created_at": {
            "type": "string",
            "minLength": 20
        },
        "created_by": {
            "type": ["string", "null"]
        },
        "updated_at": {
            "type": "string",
            "minLength": 20
        },
        "name": {
            "type": "object"
        },
        "operation_code": {
            "type": "string",
            "enum": ["incoming", "outgoing", "internal"]
        },
        "reservation_method": {
            "type": "string",
            "enum": ["at_confirmation", "manual", "before_scheduled_date"]
        },
        "reserve_before_days": {
            "type": ["integer", "null"]
        },
        "backorder_policy": {
            "type": "string",
            "enum": ["ask", "always", "never"]
        },
        "shipping_policy": {
            "type": ["string", "null"],
            "enum": ["partial", "all_at_once", null]
        },
        "sequence_prefix": {
            "type": "string",
            "pattern": "^[A-Z0-9-]+$"
        },
        "warehouse_id": {
            "type": "string",
            "minLength": 1
        },
        "default_source_location_id": {
            "type": ["string", "null"]
        },
        "default_destination_location_id": {
            "type": ["string", "null"]
        },
        "org_id": {
            "type": "string",
            "minLength": 1
        },
        "etag": {
            "type": "string",
            "minLength": 1
        },
        "is_archived": {
            "type": "boolean"
        }
    },
    "additionalProperties": false
}
