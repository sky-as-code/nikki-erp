        "last_attempt_at": {
            "type": [
                "string",
                "null"
            ]
        },
        "sent_at": {
            "type": [
                "string",
                "null"
            ]
        },
        "last_error_code": {
            "type": [
                "string",
                "null"
            ]
        },
        "last_error_message": {
            "type": [
                "string",
                "null"
            ]
        },
        "created_at": {
            "type": "string",
            "minLength": 20
