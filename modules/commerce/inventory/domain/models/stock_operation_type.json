{
	"name": "inventory_stock_operation_type",
	"label": "inventory_stock_operation_type.label",
	"table_name": "inventory_stock_operation_types",
	"should_build_db": true,
	"record_label_field": "name",
	"default_search_fields": ["code", "name", "operation_code", "reservation_method", "backorder_policy"],
	"composite_uniques": [{ "index_name": "invty_stock_op_types_tid_code_org_id", "fields": ["code", "org_id"] }],
	"extend_before": ["core.basemodel.base_model"],

	"fields": [
		{
			"name": "code",
			"label": "fields.code",
			"data_type": { "type": "resource_code", "min": 1, "max": 50 },
			"required_for_create": true
		},
		{
			"name": "name",
			"label": "fields.name",
			"data_type": { "type": "langjson", "min": 1, "max": 200 },
			"required_for_create": true
		},
		{
			"name": "operation_code",
			"label": "fields.operation_code",
			"data_type": {
				"type": "enum_string",
				"values": ["incoming", "outgoing", "internal"]
			},
			"required_for_create": true,
			"no_update": true,
			"description": "field_desc.inventory_stock_operation_type.operation_code"
		},
		{
			"name": "reservation_method",
			"label": "fields.reservation_method",
			"data_type": {
				"type": "enum_string",
				"values": ["at_confirmation", "manual", "before_scheduled_date"]
			},
			"required_for_create": true,
			"default_value": "at_confirmation",
			"description": "field_desc.inventory_stock_operation_type.reservation_method"
		},
		{
			"name": "reserve_before_days",
			"label": "fields.reserve_before_days",
			"data_type": { "type": "int32", "min": 0, "max": 2147483647 },
			"description": "field_desc.inventory_stock_operation_type.reserve_before_days"
		},
		{
			"name": "backorder_policy",
			"label": "fields.backorder_policy",
			"data_type": {
				"type": "enum_string",
				"values": ["ask", "always", "never"]
			},
			"required_for_create": true,
			"default_value": "ask",
			"description": "field_desc.inventory_stock_operation_type.backorder_policy"
		},
		{
			"name": "shipping_policy",
			"label": "fields.shipping_policy",
			"data_type": {
				"type": "enum_string",
				"values": ["partial", "all_at_once"]
			},
			"default_value": "partial",
			"description": "field_desc.inventory_stock_operation_type.shipping_policy"
		},
		{
			"name": "default_source_location_id",
			"label": "fields.default_source_location_id",
			"data_type": "ulid",
			"description": "field_desc.inventory_stock_operation_type.default_source_location_id"
		},
		{
			"name": "default_destination_location_id",
			"label": "fields.default_destination_location_id",
			"data_type": "ulid",
			"description": "field_desc.inventory_stock_operation_type.default_destination_location_id"
		},
		{
			"name": "org_id",
			"label": "fields.org_id",
			"data_type": "ulid",
			"required_for_create": true
		}
	],

	"extend_after": [
		"core.basemodel.archivable_model",
		"core.basemodel.auditable_model",
		"core.basemodel.traceable_model",
		"core.basemodel.versioned_model"
	],

	"edges_to": [
		{
			"edge": "default_source_location",
			"label": { "en-US": "Default source location" },
			"type": "many:one",
			"dest_schema": "inventory_location",
			"key_map": { "default_source_location_id": "id" },
			"on_delete": "NO ACTION"
		},
		{
			"edge": "default_destination_location",
			"label": { "en-US": "Default destination location" },
			"type": "many:one",
			"dest_schema": "inventory_location",
			"key_map": { "default_destination_location_id": "id" },
			"on_delete": "NO ACTION"
		}
	]
}
