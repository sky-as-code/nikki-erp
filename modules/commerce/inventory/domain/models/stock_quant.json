{
	"name": "inventory_stock_quant",
	"label": "inventory_stock_quant.label",
	"table_name": "inventory_stock_quants",
	"should_build_db": true,
	"default_search_fields": ["lot_ref", "on_hand_quantity", "reserved_quantity", "available_quantity"],
	"composite_uniques": [{
		"index_name": "invty_stock_quants_tid_pvar_loc_lot_pkg_own",
		"fields": ["product_variant_id", "location_id", "lot_ref", "package_ref", "owner_ref", "org_id"]
	}],
	"extend_before": ["core.basemodel.base_model"],

	"fields": [
		{
			"name": "product_variant_id",
			"label": "fields.product_variant_id",
			"data_type": "ulid",
			"required_for_create": true,
			"no_update": true,
			"description": "field_desc.inventory_stock_quant.product_variant_id"
		},
		{
			"name": "location_id",
			"label": "fields.location_id",
			"data_type": "ulid",
			"required_for_create": true,
			"no_update": true,
			"description": "field_desc.inventory_stock_quant.location_id"
		},
		{
			"name": "lot_ref",
			"label": "fields.lot_ref",
			"data_type": { "type": "string", "min": 0, "max": 100 },
			"required_for_create": true,
			"default_value": "",
			"no_update": true,
			"description": "field_desc.inventory_stock_quant.lot_ref"
		},
		{
			"name": "package_ref",
			"label": "fields.package_ref",
			"data_type": { "type": "string", "min": 0, "max": 100 },
			"required_for_create": true,
			"default_value": "",
			"no_update": true,
			"description": "field_desc.inventory_stock_quant.package_ref"
		},
		{
			"name": "owner_ref",
			"label": "fields.owner_ref",
			"data_type": { "type": "string", "min": 0, "max": 100 },
			"required_for_create": true,
			"default_value": "",
			"no_update": true,
			"description": "field_desc.inventory_stock_quant.owner_ref"
		},
		{
			"name": "base_uom_id",
			"label": "fields.base_uom_id",
			"data_type": "ulid",
			"description": "field_desc.inventory_stock_quant.base_uom_id"
		},
		{
			"name": "on_hand_quantity",
			"label": "fields.on_hand_quantity",
			"data_type": { "type": "decimal", "min": "-1000000000000", "max": "1000000000000", "scale": 6 },
			"default_value": "0",
			"no_update": true,
			"description": "field_desc.inventory_stock_quant.on_hand_quantity"
		},
		{
			"name": "reserved_quantity",
			"label": "fields.reserved_quantity",
			"data_type": { "type": "decimal", "min": "0", "max": "1000000000000", "scale": 6 },
			"default_value": "0",
			"no_update": true,
			"description": "field_desc.inventory_stock_quant.reserved_quantity"
		},
		{
			"name": "available_quantity",
			"label": "fields.available_quantity",
			"data_type": { "type": "decimal", "min": "-1000000000000", "max": "1000000000000", "scale": 6 },
			"computed": {
				"kind": "expression",
				"is_stored": false,
				"expression": {
					"op": "subtract",
					"args": [
						{ "function": "coalesce", "args": [{ "field": "on_hand_quantity" }, { "value": 0.0 }] },
						{ "function": "coalesce", "args": [{ "field": "reserved_quantity" }, { "value": 0.0 }] }
					]
				}
			},
			"description": "field_desc.inventory_stock_quant.available_quantity"
		},
		{
			"name": "incoming_date",
			"label": "fields.incoming_date",
			"data_type": "datetime",
			"description": "field_desc.inventory_stock_quant.incoming_date"
		},
		{
			"name": "counted_quantity",
			"label": "fields.counted_quantity",
			"data_type": { "type": "decimal", "min": "-1000000000000", "max": "1000000000000", "scale": 6 },
			"description": "field_desc.inventory_stock_quant.counted_quantity"
		},
		{
			"name": "count_quantity_set",
			"label": "fields.count_quantity_set",
			"data_type": "boolean",
			"default_value": false,
			"description": "field_desc.inventory_stock_quant.count_quantity_set"
		},
		{
			"name": "count_snapshot_quantity",
			"label": "fields.count_snapshot_quantity",
			"data_type": { "type": "decimal", "min": "-1000000000000", "max": "1000000000000", "scale": 6 },
			"description": "field_desc.inventory_stock_quant.count_snapshot_quantity"
		},
		{
			"name": "count_reason_code",
			"label": "fields.count_reason_code",
			"data_type": { "type": "string", "min": 0, "max": 50 },
			"description": "field_desc.inventory_stock_quant.count_reason_code"
		},
		{
			"name": "count_reason_text",
			"label": "fields.count_reason_text",
			"data_type": { "type": "string", "min": 0, "max": 500 },
			"description": "field_desc.inventory_stock_quant.count_reason_text"
		},
		{
			"name": "next_count_date",
			"label": "fields.next_count_date",
			"data_type": "date",
			"description": "field_desc.inventory_stock_quant.next_count_date"
		},
		{
			"name": "last_count_date",
			"label": "fields.last_count_date",
			"data_type": "date",
			"description": "field_desc.inventory_stock_quant.last_count_date"
		},
		{
			"name": "count_assigned_user_id",
			"label": "fields.count_assigned_user_id",
			"data_type": "ulid",
			"description": "field_desc.inventory_stock_quant.count_assigned_user_id"
		},
		{
			"name": "org_id",
			"label": "fields.org_id",
			"data_type": "ulid",
			"required_for_create": true,
			"no_update": true
		}
	],

	"search_indexes": [
		{ "index_name": "invty_stock_quants_pvar_id_loc_id", "fields": ["product_variant_id", "location_id"] },
		{ "index_name": "invty_stock_quants_loc_id_pvar_id", "fields": ["location_id", "product_variant_id"] },
		{ "index_name": "invty_stock_quants_next_count_date", "fields": ["next_count_date"] }
	],

	"extend_after": [
		"core.basemodel.auditable_model",
		"core.basemodel.traceable_model",
		"core.basemodel.versioned_model"
	],

	"edges_to": [
		{
			"edge": "product_variant",
			"label": { "en-US": "Product variant" },
			"type": "many:one",
			"dest_schema": "inventory_product_variant",
			"key_map": { "product_variant_id": "id" },
			"on_delete": "NO ACTION"
		},
		{
			"edge": "location",
			"label": { "en-US": "Location" },
			"type": "many:one",
			"dest_schema": "inventory_location",
			"key_map": { "location_id": "id" },
			"on_delete": "NO ACTION"
		},
		{
			"edge": "base_uom",
			"label": { "en-US": "Unit of measure" },
			"type": "many:one",
			"dest_schema": "essential_uom",
			"key_map": { "base_uom_id": "id" },
			"on_delete": "SET NULL"
		}
	]
}
