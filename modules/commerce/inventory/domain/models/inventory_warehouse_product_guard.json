{
	"name": "inventory_warehouse_product_guard",
	"label": "inventory_warehouse_product_guard.label",
	"table_name": "inventory_warehouse_product_guards",
	"should_build_db": true,
	"default_search_fields": ["warehouse_id", "product_variant_id"],
	"composite_uniques": [{
		"index_name": "invty_wh_prod_guards_wh_pvar_org",
		"fields": ["warehouse_id", "product_variant_id", "org_id"]
	}],
	"extend_before": ["core.basemodel.base_model"],

	"fields": [
		{
			"name": "warehouse_id",
			"label": "fields.warehouse_id",
			"data_type": "ulid",
			"required_for_create": true,
			"no_update": true,
			"description": {
				"en-US": "One half of the scope this row serialises. A guard row exists for exactly one (warehouse, variant) pair per org and carries nothing else: it is a lock target, not a balance. Every operation that changes or commits that scope's stock takes this row FOR UPDATE first, so two requests that would pick different quants still queue behind one another."
			}
		},
		{
			"name": "product_variant_id",
			"label": "fields.product_variant_id",
			"data_type": "ulid",
			"required_for_create": true,
			"no_update": true
		},
		{
			"name": "org_id",
			"label": "fields.org_id",
			"data_type": "ulid",
			"required_for_create": true,
			"no_update": true
		}
	],

	"extend_after": [
		"core.basemodel.auditable_model"
	],

	"edges_to": [
		{
			"edge": "warehouse",
			"label": { "en-US": "Warehouse" },
			"type": "many:one",
			"dest_schema": "inventory_warehouse",
			"key_map": { "warehouse_id": "id" },
			"on_delete": "CASCADE"
		},
		{
			"edge": "product_variant",
			"label": { "en-US": "Product variant" },
			"type": "many:one",
			"dest_schema": "inventory_product_variant",
			"key_map": { "product_variant_id": "id" },
			"on_delete": "CASCADE"
		}
	]
}
