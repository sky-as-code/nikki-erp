{
	"name": "inventory_product_attribute",
	"label": "inventory_product_attribute.label",
	"table_name": "inventory_product_attributes",
	"should_build_db": true,
	"record_label_field": "name",
	"default_search_fields": ["code", "name", "data_type", "variant_creation_mode", "sequence"],
	"composite_uniques": [{ "index_name": "invty_prod_attrs_tid_code_org_id", "fields": ["code", "org_id"] }],
	"extend_before": ["core.basemodel.base_model"],

	"fields": [
		{
			"name": "code",
			"label": "fields.code",
			"data_type": { "type": "resource_code", "min": 1, "max": 50 },
			"required_for_create": true
		},
		{
			"name": "name",
			"label": "fields.name",
			"data_type": { "type": "langjson", "min": 1, "max": 200 },
			"required_for_create": true
		},
		{
			"name": "data_type",
			"label": "fields.data_type",
			"data_type": {
				"type": "enum_string",
				"values": ["option", "text", "number", "date", "boolean"]
			},
			"required_for_create": true,
			"default_value": "option",
			"description": "field_desc.inventory_product_attribute.data_type"
		},
		{
			"name": "variant_creation_mode",
			"label": "fields.variant_creation_mode",
			"data_type": {
				"type": "enum_string",
				"values": ["instant", "dynamic", "never"]
			},
			"required_for_create": true,
			"default_value": "dynamic",
			"description": "field_desc.inventory_product_attribute.variant_creation_mode"
		},
		{
			"name": "display_type",
			"label": "fields.display_type",
			"data_type": {
				"type": "enum_string",
				"values": ["pills", "radio", "select", "color", "multi_checkbox"]
			},
			"description": "field_desc.inventory_product_attribute.display_type"
		},
		{
			"name": "sequence",
			"label": "fields.sequence",
			"data_type": { "type": "int32", "min": 0, "max": 2147483647 },
			"description": "field_desc.inventory_product_attribute.sequence"
		},
		{
			"name": "org_id",
			"label": "fields.org_id",
			"data_type": "ulid",
			"required_for_create": true
		},
		{
			"name": "current_template_usage_count",
			"label": "fields.current_template_usage_count",
			"data_type": { "type": "int64", "min": 0, "max": 1000000000 },
			"computed": {
				"kind": "aggregate",
				"is_stored": false,
				"source": "template_lines",
				"function": "count_distinct",
				"field": "product_template_id",
				"filter": { "if": ["is_enabled", "=", true] }
			},
			"description": "field_desc.inventory_product_attribute.current_template_usage_count"
		},
		{
			"name": "historical_template_usage_count",
			"label": "fields.historical_template_usage_count",
			"data_type": { "type": "int64", "min": 0, "max": 1000000000 },
			"computed": {
				"kind": "aggregate",
				"is_stored": false,
				"source": "template_lines",
				"function": "count_distinct",
				"field": "product_template_id",
				"filter": { "if": ["is_enabled", "=", false] }
			},
			"description": "field_desc.inventory_product_attribute.historical_template_usage_count"
		},
		{
			"name": "can_change_variant_creation",
			"label": "fields.can_change_variant_creation",
			"data_type": "boolean",
			"computed": {
				"kind": "expression",
				"is_stored": false,
				"expression": {
					"op": "and",
					"args": [
						{ "op": "not", "args": [{ "field": "is_archived" }] },
						{ "op": "eq", "args": [{ "function": "coalesce", "args": [{ "field": "current_template_usage_count" }, { "value": 0 }] }, { "value": 0 }] }
					]
				}
			},
			"description": "field_desc.inventory_product_attribute.can_change_variant_creation"
		}
	],

	"extend_after": [
		"core.basemodel.archivable_model",
		"core.basemodel.auditable_model",
		"core.basemodel.traceable_model",
		"core.basemodel.versioned_model"
	],

	"edges_from": [
		{
			"edge": "template_lines",
			"label": { "en-US": "Template lines" },
			"existing": { "src_schema": "inventory_product_template_attribute", "src_edge": "attribute" }
		},
		{
			"edge": "values",
			"label": { "en-US": "Values" },
			"existing": { "src_schema": "inventory_product_attribute_value", "src_edge": "attribute" }
		}
	]
}
