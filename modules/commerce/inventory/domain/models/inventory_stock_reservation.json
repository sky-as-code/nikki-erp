{
	"name": "inventory_stock_reservation",
	"label": "inventory_stock_reservation.label",
	"table_name": "inventory_stock_reservations",
	"should_build_db": true,
	"default_search_fields": ["status", "effective_status", "quantity", "remaining_quantity", "reserved_until", "source_module", "source_type", "source_id"],
	"composite_uniques": [{
		"index_name": "invty_stock_rsv_source_line_rev_org",
		"fields": ["source_module", "source_type", "source_id", "source_line_id", "source_revision", "org_id"]
	}],
	"extend_before": ["core.basemodel.base_model"],

	"fields": [
		{
			"name": "warehouse_id",
			"label": "fields.warehouse_id",
			"data_type": "ulid",
			"required_for_create": true,
			"no_update": true,
			"description": "field_desc.inventory_stock_reservation.warehouse_id"
		},
		{
			"name": "product_variant_id",
			"label": "fields.product_variant_id",
			"data_type": "ulid",
			"required_for_create": true,
			"no_update": true,
			"description": "field_desc.inventory_stock_reservation.product_variant_id"
		},
		{
			"name": "base_uom_id",
			"label": "fields.base_uom_id",
			"data_type": "ulid",
			"required_for_create": true,
			"no_update": true,
			"description": "field_desc.inventory_stock_reservation.base_uom_id"
		},
		{
			"name": "quantity",
			"label": "fields.quantity",
			"data_type": { "type": "decimal", "min": "0", "max": "1000000000000", "scale": 6 },
			"required_for_create": true,
			"no_update": true,
			"description": "field_desc.inventory_stock_reservation.quantity"
		},
		{
			"name": "consumed_quantity",
			"label": "fields.consumed_quantity",
			"data_type": { "type": "decimal", "min": "0", "max": "1000000000000", "scale": 6 },
			"required_for_create": true,
			"default_value": "0",
			"description": "field_desc.inventory_stock_reservation.consumed_quantity"
		},
		{
			"name": "released_quantity",
			"label": "fields.released_quantity",
			"data_type": { "type": "decimal", "min": "0", "max": "1000000000000", "scale": 6 },
			"required_for_create": true,
			"default_value": "0",
			"description": "field_desc.inventory_stock_reservation.released_quantity"
		},
		{
			"name": "remaining_quantity",
			"label": "fields.remaining_quantity",
			"data_type": { "type": "decimal", "min": "-1000000000000", "max": "1000000000000", "scale": 6 },
			"computed": {
				"kind": "expression",
				"is_stored": false,
				"expression": {
					"op": "subtract",
					"args": [
						{
							"op": "subtract",
							"args": [
								{ "function": "coalesce", "args": [{ "field": "quantity" }, { "value": 0.0 }] },
								{ "function": "coalesce", "args": [{ "field": "consumed_quantity" }, { "value": 0.0 }] }
							]
						},
						{ "function": "coalesce", "args": [{ "field": "released_quantity" }, { "value": 0.0 }] }
					]
				}
			},
			"description": "field_desc.inventory_stock_reservation.remaining_quantity"
		},
		{
			"name": "reserved_until",
			"label": "fields.reserved_until",
			"data_type": "datetime",
			"description": "field_desc.inventory_stock_reservation.reserved_until"
		},
		{
			"name": "status",
			"label": "fields.status",
			"data_type": {
				"type": "enum_string",
				"values": ["active", "consumed", "released"]
			},
			"required_for_create": true,
			"default_value": "active"
		},
		{
			"name": "effective_status",
			"label": "fields.effective_status",
			"data_type": {
				"type": "enum_string",
				"values": ["active", "consumed", "released", "expired"]
			},
			"computed": {
				"kind": "expression",
				"is_stored": false,
				"expression": {
					"case": {
						"when": [
							{
								"if": {
									"op": "and",
									"args": [
										{ "op": "eq", "args": [{ "field": "status" }, { "value": "active" }] },
										{ "op": "is_not_null", "args": [{ "field": "reserved_until" }] },
										{ "op": "lte", "args": [{ "field": "reserved_until" }, { "function": "now" }] }
									]
								},
								"then": { "value": "expired" }
							}
						],
						"else": { "field": "status" }
					}
				}
			},
			"description": "field_desc.inventory_stock_reservation.effective_status"
		},
		{
			"name": "effective_reserved_quantity",
			"label": "fields.effective_reserved_quantity",
			"data_type": { "type": "decimal", "min": "-1000000000000", "max": "1000000000000", "scale": 6 },
			"computed": {
				"kind": "expression",
				"is_stored": false,
				"expression": {
					"case": {
						"when": [
							{
								"if": {
									"op": "and",
									"args": [
										{ "op": "eq", "args": [{ "field": "status" }, { "value": "active" }] },
										{
											"op": "or",
											"args": [
												{ "op": "is_null", "args": [{ "field": "reserved_until" }] },
												{ "op": "gt", "args": [{ "field": "reserved_until" }, { "function": "now" }] }
											]
										}
									]
								},
								"then": { "field": "remaining_quantity" }
							}
						],
						"else": { "value": 0.0 }
					}
				}
			},
			"description": "field_desc.inventory_stock_reservation.effective_reserved_quantity"
		},
		{
			"name": "source_module",
			"label": "fields.source_module",
			"data_type": { "type": "string", "min": 1, "max": 50 },
			"required_for_create": true,
			"no_update": true,
			"description": "field_desc.inventory_stock_reservation.source_module"
		},
		{
			"name": "source_type",
			"label": "fields.source_type",
			"data_type": { "type": "string", "min": 1, "max": 50 },
			"required_for_create": true,
			"no_update": true,
			"description": "field_desc.inventory_stock_reservation.source_type"
		},
		{
			"name": "source_id",
			"label": "fields.source_id",
			"data_type": { "type": "string", "min": 1, "max": 255 },
			"required_for_create": true,
			"no_update": true,
			"description": "field_desc.inventory_stock_reservation.source_id"
		},
		{
			"name": "source_line_id",
			"label": "fields.source_line_id",
			"data_type": { "type": "string", "min": 0, "max": 255 },
			"required_for_create": true,
			"default_value": "",
			"no_update": true,
			"description": "field_desc.inventory_stock_reservation.source_line_id"
		},
		{
			"name": "source_revision",
			"label": "fields.source_revision",
			"data_type": { "type": "int32", "min": 1, "max": 1000000 },
			"required_for_create": true,
			"default_value": 1,
			"no_update": true,
			"description": "field_desc.inventory_stock_reservation.source_revision"
		},
		{
			"name": "idempotency_key",
			"label": "fields.idempotency_key",
			"data_type": { "type": "string", "min": 1, "max": 100 },
			"required_for_create": true,
			"no_update": true,
			"description": "field_desc.inventory_stock_reservation.idempotency_key"
		},
		{
			"name": "request_fingerprint",
			"label": "fields.request_fingerprint",
			"data_type": { "type": "string", "min": 1, "max": 100 },
			"required_for_create": true,
			"no_update": true,
			"description": "field_desc.inventory_stock_reservation.request_fingerprint"
		},
		{
			"name": "release_reason",
			"label": "fields.release_reason",
			"data_type": { "type": "string", "min": 0, "max": 100 },
			"description": "field_desc.inventory_stock_reservation.release_reason"
		},
		{
			"name": "released_at",
			"label": "fields.released_at",
			"data_type": "datetime",
			"description": "field_desc.inventory_stock_reservation.released_at"
		},
		{
			"name": "expiry_recorded_at",
			"label": "fields.expiry_recorded_at",
			"data_type": "datetime",
			"description": "field_desc.inventory_stock_reservation.expiry_recorded_at"
		},
		{
			"name": "org_id",
			"label": "fields.org_id",
			"data_type": "ulid",
			"required_for_create": true,
			"no_update": true
		}
	],

	"search_indexes": [
		{ "index_name": "invty_stock_rsv_scope_status_until", "fields": ["org_id", "warehouse_id", "product_variant_id", "status", "reserved_until"] },
		{ "index_name": "invty_stock_rsv_until_id", "fields": ["reserved_until", "id"] },
		{ "index_name": "invty_stock_rsv_org_idem_key", "fields": ["org_id", "idempotency_key"] },
		{ "index_name": "invty_stock_rsv_source", "fields": ["source_module", "source_type", "source_id"] }
	],

	"extend_after": [
		"core.basemodel.auditable_model",
		"core.basemodel.traceable_model",
		"core.basemodel.versioned_model"
	],

	"edges_to": [
		{
			"edge": "warehouse",
			"label": { "en-US": "Warehouse" },
			"type": "many:one",
			"dest_schema": "inventory_warehouse",
			"key_map": { "warehouse_id": "id" },
			"on_delete": "RESTRICT"
		},
		{
			"edge": "product_variant",
			"label": { "en-US": "Product variant" },
			"type": "many:one",
			"dest_schema": "inventory_product_variant",
			"key_map": { "product_variant_id": "id" },
			"on_delete": "RESTRICT"
		},
		{
			"edge": "base_uom",
			"label": { "en-US": "Unit of measure" },
			"type": "many:one",
			"dest_schema": "essential_uom",
			"key_map": { "base_uom_id": "id" },
			"on_delete": "RESTRICT"
		}
	]
}
