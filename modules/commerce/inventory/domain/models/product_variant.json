{
	"name": "inventory_product_variant",
	"label": "inventory_product_variant.label",
	"table_name": "inventory_product_variants",
	"should_build_db": true,
	"record_label_field": "display_name",
	"default_search_fields": ["sku", "product_template_name", "attribute_summary", "effective_base_sales_price", "cost", "on_hand_quantity", "product_template_uom_name", "status"],
	"composite_uniques": [{ "index_name": "invty_prod_variants_tid_ptpl_id_kind_comb_key", "fields": ["product_template_id", "variant_kind", "combination_key"] }],
	"partial_uniques_strict": [
		{ "index_name": "invty_prod_variants_tid_src_sys_ext_id", "not_null_fields": ["source_system"], "nullable_field": "external_id" },
		{ "index_name": "invty_prod_variants_tid_org_sku", "not_null_fields": ["org_id"], "nullable_field": "sku" },
		{ "index_name": "invty_prod_variants_tid_org_barcode", "not_null_fields": ["org_id"], "nullable_field": "primary_barcode" }
	],
	"extend_before": ["core.basemodel.base_model"],

	"fields": [
		{
			"name": "product_template_id",
			"label": "fields.product_template_id",
			"data_type": "ulid",
			"required_for_create": true,
			"no_update": true,
			"description": "field_desc.inventory_product_variant.product_template_id"
		},
		{
			"name": "variant_kind",
			"label": "fields.variant_kind",
			"data_type": {
				"type": "enum_string",
				"values": ["base", "complete"]
			},
			"required_for_create": true,
			"default_value": "complete",
			"no_update": true,
			"description": "field_desc.inventory_product_variant.variant_kind"
		},
		{
			"name": "base_variant_id",
			"label": "fields.base_variant_id",
			"data_type": "ulid",
			"no_update": true,
			"description": "field_desc.inventory_product_variant.base_variant_id"
		},
		{
			"name": "combination_key",
			"label": "fields.combination_key",
			"data_type": { "type": "string", "min": 0, "max": 1000 },
			"required_for_create": true,
			"description": "field_desc.inventory_product_variant.combination_key"
		},
		{
			"name": "sku",
			"label": "fields.sku",
			"data_type": { "type": "resource_code", "min": 0, "max": 100 },
			"description": "field_desc.inventory_product_variant.sku"
		},
		{
			"name": "primary_barcode",
			"label": "fields.primary_barcode",
			"data_type": { "type": "string", "min": 0, "max": 100 },
			"description": "field_desc.inventory_product_variant.primary_barcode"
		},
		{
			"name": "preview_image_file_id",
			"label": "fields.preview_image_file_id",
			"data_type": "ulid",
			"metadata": { "file_field": true },
			"description": "field_desc.inventory_product_variant.preview_image_file_id"
		},
		{
			"name": "cost",
			"label": "fields.cost",
			"data_type": { "type": "decimal", "min": "0", "max": "1000000000000", "scale": 6 },
			"default_value": "0",
			"description": "field_desc.inventory_product_variant.cost"
		},
		{
			"name": "weight",
			"label": "fields.weight",
			"data_type": { "type": "decimal", "min": "0", "max": "1000000000000", "scale": 6 },
			"description": "field_desc.inventory_product_variant.weight"
		},
		{
			"name": "length",
			"label": "fields.length",
			"data_type": { "type": "decimal", "min": "0", "max": "1000000000000", "scale": 6 },
			"description": "field_desc.inventory_product_variant.length"
		},
		{
			"name": "width",
			"label": "fields.width",
			"data_type": { "type": "decimal", "min": "0", "max": "1000000000000", "scale": 6 },
			"description": "field_desc.inventory_product_variant.width"
		},
		{
			"name": "height",
			"label": "fields.height",
			"data_type": { "type": "decimal", "min": "0", "max": "1000000000000", "scale": 6 },
			"description": "field_desc.inventory_product_variant.height"
		},
		{
			"name": "status",
			"label": "fields.status",
			"data_type": {
				"type": "enum_string",
				"values": ["active", "discontinued"]
			},
			"required_for_create": true,
			"default_value": "active"
		},
		{
			"name": "archive_source",
			"label": "fields.archive_source",
			"data_type": {
				"type": "enum_string",
				"values": ["user", "template_cascade", "system_sync"]
			},
			"description": "field_desc.inventory_product_variant.archive_source"
		},
		{
			"name": "source_system",
			"label": "fields.source_system",
			"data_type": { "type": "string", "min": 1, "max": 50 },
			"required_for_create": true,
			"default_value": "manual",
			"description": "field_desc.inventory_product_variant.source_system"
		},
		{
			"name": "external_id",
			"label": "fields.external_id",
			"data_type": { "type": "string", "min": 1, "max": 200 },
			"description": "field_desc.inventory_product_variant.external_id"
		},
		{
			"name": "org_id",
			"label": "fields.org_id",
			"data_type": "ulid",
			"required_for_create": true
		},

		{
			"name": "product_template_name",
			"label": "fields.product_name",
			"data_type": { "type": "langjson", "min": 1, "max": 200 },
			"computed": { "kind": "related", "is_stored": false, "field": "product_template.name" },
			"description": "field_desc.inventory_product_variant.product_template_name"
		},
		{
			"name": "product_template_is_archived",
			"label": "fields.product_template_is_archived",
			"data_type": "boolean",
			"computed": { "kind": "related", "is_stored": false, "field": "product_template.is_archived" },
			"description": "field_desc.inventory_product_variant.product_template_is_archived"
		},
		{
			"name": "product_template_short_name",
			"label": "fields.product_template_short_name",
			"data_type": { "type": "langjson", "min": 0, "max": 100 },
			"computed": { "kind": "related", "is_stored": false, "field": "product_template.short_name" },
			"description": "field_desc.inventory_product_variant.product_template_short_name"
		},
		{
			"name": "product_template_description",
			"label": "fields.product_template_description",
			"data_type": { "type": "string", "min": 0, "max": 4000 },
			"computed": { "kind": "related", "is_stored": false, "field": "product_template.description" },
			"description": "field_desc.inventory_product_variant.product_template_description"
		},
		{
			"name": "product_template_sales_description",
			"label": "fields.product_template_sales_description",
			"data_type": { "type": "string", "min": 0, "max": 4000 },
			"computed": { "kind": "related", "is_stored": false, "field": "product_template.sales_description" },
			"description": "field_desc.inventory_product_variant.product_template_sales_description"
		},
		{
			"name": "product_template_purchase_description",
			"label": "fields.product_template_purchase_description",
			"data_type": { "type": "string", "min": 0, "max": 4000 },
			"computed": { "kind": "related", "is_stored": false, "field": "product_template.purchase_description" },
			"description": "field_desc.inventory_product_variant.product_template_purchase_description"
		},
		{
			"name": "product_template_category_id",
			"label": "fields.product_template_category_id",
			"data_type": "ulid",
			"computed": { "kind": "related", "is_stored": false, "field": "product_template.category_id" },
			"description": "field_desc.inventory_product_variant.product_template_category_id"
		},
		{
			"name": "product_template_brand_id",
			"label": "fields.product_template_brand_id",
			"data_type": "ulid",
			"computed": { "kind": "related", "is_stored": false, "field": "product_template.brand_id" },
			"description": "field_desc.inventory_product_variant.product_template_brand_id"
		},
		{
			"name": "product_template_preview_image_file_id",
			"label": "fields.product_template_preview_image_file_id",
			"data_type": "ulid",
			"computed": { "kind": "related", "is_stored": false, "field": "product_template.preview_image_file_id" },
			"description": "field_desc.inventory_product_variant.product_template_preview_image_file_id"
		},
		{
			"name": "product_template_product_type",
			"label": "fields.product_template_product_type",
			"data_type": {
				"type": "enum_string",
				"values": ["goods", "service"]
			},
			"computed": { "kind": "related", "is_stored": false, "field": "product_template.product_type" },
			"description": "field_desc.inventory_product_variant.product_template_product_type"
		},
		{
			"name": "product_template_is_combo",
			"label": "fields.product_template_is_combo",
			"data_type": "boolean",
			"computed": { "kind": "related", "is_stored": false, "field": "product_template.is_combo" },
			"description": "field_desc.inventory_product_variant.product_template_is_combo"
		},
		{
			"name": "product_template_status",
			"label": "fields.product_template_status",
			"data_type": {
				"type": "enum_string",
				"values": ["draft", "active", "discontinued"]
			},
			"computed": { "kind": "related", "is_stored": false, "field": "product_template.status" },
			"description": "field_desc.inventory_product_variant.product_template_status"
		},
		{
			"name": "product_template_sale_ok",
			"label": "fields.product_template_sale_ok",
			"data_type": "boolean",
			"computed": { "kind": "related", "is_stored": false, "field": "product_template.sale_ok" },
			"description": "field_desc.inventory_product_variant.product_template_sale_ok"
		},
		{
			"name": "product_template_purchase_ok",
			"label": "fields.product_template_purchase_ok",
			"data_type": "boolean",
			"computed": { "kind": "related", "is_stored": false, "field": "product_template.purchase_ok" },
			"description": "field_desc.inventory_product_variant.product_template_purchase_ok"
		},
		{
			"name": "product_template_base_sales_price",
			"label": "fields.product_template_base_sales_price",
			"data_type": { "type": "decimal", "min": "0", "max": "1000000000000", "scale": 6 },
			"computed": { "kind": "related", "is_stored": false, "field": "product_template.base_sales_price" },
			"description": "field_desc.inventory_product_variant.product_template_base_sales_price"
		},
		{
			"name": "product_template_uom_id",
			"label": "fields.product_template_uom_id",
			"data_type": "ulid",
			"computed": { "kind": "related", "is_stored": false, "field": "product_template.uom_id" },
			"description": "field_desc.inventory_product_variant.product_template_uom_id"
		},
		{
			"name": "product_template_uom_name",
			"label": "fields.product_template_uom_name",
			"data_type": { "type": "langjson", "min": 0, "max": 200 },
			"computed": { "kind": "related", "is_stored": false, "field": "product_template.uom.name" },
			"description": "field_desc.inventory_product_variant.product_template_uom_name"
		},
		{
			"name": "display_name",
			"label": "fields.display_name",
			"data_type": { "type": "string", "min": 0, "max": 400 },
			"computed": { "kind": "function", "is_stored": false, "function": "inventory.variant_display_name" },
			"description": "field_desc.inventory_product_variant.display_name"
		},
		{
			"name": "attribute_summary",
			"label": "fields.attributes",
			"data_type": { "type": "string", "array": true, "min": 0, "max": 400 },
			"computed": { "kind": "function", "is_stored": false, "function": "inventory.variant_attribute_summary" },
			"description": "field_desc.inventory_product_variant.attribute_summary"
		},
		{
			"name": "sales_price_extra_total",
			"label": "fields.sales_price_extra_total",
			"data_type": { "type": "decimal", "min": "-1000000000000", "max": "1000000000000", "scale": 6 },
			"computed": {
				"kind": "aggregate",
				"is_stored": false,
				"source": "attribute_values",
				"function": "sum",
				"field": "sales_price_extra",
				"default": 0.0
			},
			"description": "field_desc.inventory_product_variant.sales_price_extra_total"
		},
		{
			"name": "effective_base_sales_price",
			"label": "fields.sale_price",
			"data_type": { "type": "decimal", "min": "-1000000000000", "max": "1000000000000", "scale": 6 },
			"computed": {
				"kind": "expression",
				"is_stored": false,
				"expression": {
					"op": "add",
					"args": [
						{ "function": "coalesce", "args": [{ "field": "product_template_base_sales_price" }, { "value": 0.0 }] },
						{ "function": "coalesce", "args": [{ "field": "sales_price_extra_total" }, { "value": 0.0 }] }
					]
				}
			},
			"description": "field_desc.inventory_product_variant.effective_base_sales_price"
		},
		{
			"name": "on_hand_quantity",
			"label": "fields.on_hand_quantity",
			"data_type": { "type": "decimal", "min": "-1000000000000", "max": "1000000000000", "scale": 6 },
			"computed": {
				"kind": "aggregate",
				"is_stored": false,
				"source": "quants",
				"function": "sum",
				"field": "on_hand_quantity",
				"default": 0.0
			},
			"description": "field_desc.inventory_product_variant.on_hand_quantity"
		},
		{
			"name": "reserved_quantity",
			"label": "fields.reserved_quantity",
			"data_type": { "type": "decimal", "min": "0", "max": "1000000000000", "scale": 6 },
			"computed": {
				"kind": "aggregate",
				"is_stored": false,
				"source": "quants",
				"function": "sum",
				"field": "reserved_quantity",
				"default": 0.0
			},
			"description": "field_desc.inventory_product_variant.reserved_quantity"
		},
		{
			"name": "available_quantity",
			"label": "fields.available_quantity",
			"data_type": { "type": "decimal", "min": "-1000000000000", "max": "1000000000000", "scale": 6 },
			"computed": {
				"kind": "expression",
				"is_stored": false,
				"expression": {
					"op": "subtract",
					"args": [
						{ "function": "coalesce", "args": [{ "field": "on_hand_quantity" }, { "value": 0.0 }] },
						{ "function": "coalesce", "args": [{ "field": "reserved_quantity" }, { "value": 0.0 }] }
					]
				}
			},
			"description": "field_desc.inventory_product_variant.available_quantity"
		},
		{
			"name": "is_transaction_eligible",
			"label": "fields.is_transaction_eligible",
			"data_type": "boolean",
			"computed": {
				"kind": "expression",
				"is_stored": false,
				"expression": {
					"op": "and",
					"args": [
						{
							"op": "and",
							"args": [
								{ "op": "eq", "args": [{ "field": "variant_kind" }, { "value": "complete" }] },
								{ "op": "eq", "args": [{ "field": "status" }, { "value": "active" }] }
							]
						},
						{
							"op": "and",
							"args": [
								{ "op": "not", "args": [{ "field": "is_archived" }] },
								{
									"op": "and",
									"args": [
										{ "op": "not", "args": [{ "function": "coalesce", "args": [{ "field": "product_template_is_archived" }, { "value": false }] }] },
										{ "op": "not", "args": [{ "op": "eq", "args": [{ "function": "coalesce", "args": [{ "field": "product_template_status" }, { "value": "draft" }] }, { "value": "discontinued" }] }] }
									]
								}
							]
						}
					]
				}
			},
			"description": "field_desc.inventory_product_variant.is_transaction_eligible"
		}
	],

	"extend_after": [
		"core.basemodel.archivable_model",
		"core.basemodel.auditable_model",
		"core.basemodel.traceable_model",
		"core.basemodel.versioned_model"
	],

	"edges_to": [
		{
			"edge": "product_template",
			"label": { "en-US": "Product template" },
			"type": "many:one",
			"dest_schema": "inventory_product_template",
			"key_map": { "product_template_id": "id" },
			"on_delete": "NO ACTION"
		},
		{
			"edge": "base_variant",
			"label": { "en-US": "Base variant" },
			"type": "many:one",
			"dest_schema": "inventory_product_variant",
			"key_map": { "base_variant_id": "id" },
			"on_delete": "RESTRICT"
		}
	],

	"edges_from": [
		{
			"edge": "quants",
			"label": { "en-US": "Stock balances" },
			"existing": { "src_schema": "inventory_stock_quant", "src_edge": "product_variant" }
		},
		{
			"edge": "attribute_values",
			"label": { "en-US": "Attribute values" },
			"existing": { "src_schema": "inventory_product_variant_attribute_value", "src_edge": "variant" }
		}
	]
}
