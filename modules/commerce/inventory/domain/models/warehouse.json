{
	"name": "inventory_warehouse",
	"label": "inventory_warehouse.label",
	"table_name": "inventory_warehouses",
	"should_build_db": true,
	"record_label_field": "name",
	"default_search_fields": ["code", "name", "warehouse_role", "incoming_flow", "outgoing_flow", "status"],
	"composite_uniques": [{ "index_name": "invty_whs_tid_code_org_id", "fields": ["code", "org_id"] }],
	"extend_before": ["core.basemodel.base_model"],

	"fields": [
		{
			"name": "code",
			"label": "fields.code",
			"data_type": { "type": "resource_code", "min": 1, "max": 20 },
			"required_for_create": true
		},
		{
			"name": "name",
			"label": "fields.name",
			"data_type": { "type": "string", "min": 1, "max": 200 },
			"required_for_create": true
		},
		{
			"name": "warehouse_role",
			"label": "fields.warehouse_role",
			"data_type": {
				"type": "enum_string",
				"values": ["central", "sub", "pos", "other"]
			},
			"required_for_create": true,
			"default_value": "other",
			"description": "field_desc.inventory_warehouse.warehouse_role"
		},
		{
			"name": "root_location_id",
			"label": "fields.root_location_id",
			"data_type": "ulid",
			"auto_generated": true,
			"description": "field_desc.inventory_warehouse.root_location_id"
		},
		{
			"name": "address",
			"label": "fields.address",
			"data_type": { "type": "string", "min": 0, "max": 500 },
			"description": "field_desc.inventory_warehouse.address"
		},
		{
			"name": "manager_user_id",
			"label": "fields.manager_user_id",
			"data_type": "ulid",
			"description": "field_desc.inventory_warehouse.manager_user_id"
		},
		{
			"name": "incoming_flow",
			"label": "fields.incoming_flow",
			"data_type": {
				"type": "enum_string",
				"values": ["one_step", "two_step", "three_step"]
			},
			"required_for_create": true,
			"default_value": "one_step",
			"description": "field_desc.inventory_warehouse.incoming_flow"
		},
		{
			"name": "outgoing_flow",
			"label": "fields.outgoing_flow",
			"data_type": {
				"type": "enum_string",
				"values": ["one_step", "two_step", "three_step"]
			},
			"required_for_create": true,
			"default_value": "one_step",
			"description": "field_desc.inventory_warehouse.outgoing_flow"
		},
		{
			"name": "status",
			"label": "fields.status",
			"data_type": {
				"type": "enum_string",
				"values": ["active", "suspended"]
			},
			"required_for_create": true,
			"default_value": "active"
		},
		{
			"name": "notes",
			"label": "fields.notes",
			"data_type": { "type": "string", "min": 0, "max": 2000 }
		},
		{
			"name": "org_id",
			"label": "fields.org_id",
			"data_type": "ulid",
			"required_for_create": true
		}
	],

	"extend_after": [
		"core.basemodel.archivable_model",
		"core.basemodel.auditable_model",
		"core.basemodel.traceable_model",
		"core.basemodel.managed_model",
		"core.basemodel.versioned_model"
	],

	"edges_to": [
		{
			"edge": "root_location",
			"label": { "en-US": "Root location" },
			"type": "many:one",
			"dest_schema": "inventory_location",
			"key_map": { "root_location_id": "id" },
			"on_delete": "RESTRICT"
		},
		{
			"edge": "manager_user",
			"label": { "en-US": "Manager" },
			"type": "many:one",
			"dest_schema": "iam_user",
			"key_map": { "manager_user_id": "id" },
			"on_delete": "SET NULL"
		}
	]
}
