{
	"name": "inventory_location",
	"label": "inventory_location.label",
	"table_name": "inventory_locations",
	"should_build_db": true,
	"record_label_field": "canonical_name",
	"default_search_fields": ["name", "canonical_name", "location_usage", "purpose", "status"],
	"extend_before": ["core.basemodel.base_model"],

	"fields": [
		{
			"name": "name",
			"label": "fields.name",
			"data_type": { "type": "string", "min": 1, "max": 200 },
			"required_for_create": true
		},
		{
			"name": "canonical_name",
			"label": "fields.canonical_name",
			"data_type": { "type": "string", "min": 1, "max": 2000 },
			"auto_generated": true,
			"description": "field_desc.inventory_location.canonical_name"
		},
		{
			"name": "location_usage",
			"label": "fields.location_usage",
			"data_type": {
				"type": "enum_string",
				"values": ["internal", "customer", "vendor", "inventory_loss", "scrap", "transit", "virtual"]
			},
			"required_for_create": true,
			"default_value": "internal",
			"description": "field_desc.inventory_location.location_usage"
		},
		{
			"name": "purpose",
			"label": "fields.purpose",
			"data_type": {
				"type": "enum_string",
				"values": ["storage", "receiving", "quality", "picking", "packing", "output", "other"]
			},
			"description": "field_desc.inventory_location.purpose"
		},
		{
			"name": "warehouse_id",
			"label": "fields.warehouse_id",
			"data_type": "ulid",
			"auto_generated": true,
			"description": "field_desc.inventory_location.warehouse_id"
		},
		{
			"name": "parent_location_id",
			"label": "fields.parent_location_id",
			"data_type": "ulid",
			"description": "field_desc.inventory_location.parent_location_id"
		},
		{
			"name": "hierarchy_depth",
			"label": "fields.hierarchy_depth",
			"data_type": { "type": "int32", "min": 0, "max": 2147483647 },
			"default_value": 0,
			"description": "field_desc.inventory_location.hierarchy_depth"
		},
		{
			"name": "barcode",
			"label": "fields.barcode",
			"data_type": { "type": "string", "min": 0, "max": 100 },
			"description": "field_desc.inventory_location.barcode"
		},
		{
			"name": "storage_category_id",
			"label": "fields.storage_category_id",
			"data_type": "ulid",
			"description": "field_desc.inventory_location.storage_category_id"
		},
		{
			"name": "removal_strategy",
			"label": "fields.removal_strategy",
			"data_type": {
				"type": "enum_string",
				"values": ["fifo", "lifo", "fefo", "closest", "least_packages"]
			},
			"description": "field_desc.inventory_location.removal_strategy"
		},
		{
			"name": "is_replenishment_destination",
			"label": "fields.is_replenishment_destination",
			"data_type": "boolean",
			"required_for_create": true,
			"default_value": false,
			"description": "field_desc.inventory_location.is_replenishment_destination"
		},
		{
			"name": "is_system_generated",
			"label": "fields.is_system_generated",
			"data_type": "boolean",
			"required_for_create": true,
			"default_value": false,
			"no_update": true,
			"description": "field_desc.inventory_location.is_system_generated"
		},
		{
			"name": "status",
			"label": "fields.status",
			"data_type": {
				"type": "enum_string",
				"values": ["active", "suspended"]
			},
			"required_for_create": true,
			"default_value": "active"
		},
		{
			"name": "description",
			"label": "fields.description",
			"data_type": { "type": "string", "min": 0, "max": 2000 }
		},
		{
			"name": "org_id",
			"label": "fields.org_id",
			"data_type": "ulid",
			"required_for_create": true
		}
	],

	"search_indexes": [
		{ "index_name": "invty_locs_warehouse_id", "fields": ["warehouse_id"] },
		{ "index_name": "invty_locs_parent_location_id", "fields": ["parent_location_id"] },
		{ "index_name": "invty_locs_barcode", "fields": ["barcode"] }
	],

	"extend_after": [
		"core.basemodel.archivable_model",
		"core.basemodel.auditable_model",
		"core.basemodel.traceable_model",
		"core.basemodel.managed_model",
		"core.basemodel.versioned_model"
	],

	"edges_to": [
		{
			"edge": "parent_location",
			"label": { "en-US": "Parent location" },
			"type": "many:one",
			"dest_schema": "inventory_location",
			"key_map": { "parent_location_id": "id" },
			"on_delete": "NO ACTION"
		},
		{
			"edge": "warehouse",
			"label": { "en-US": "Warehouse" },
			"type": "many:one",
			"dest_schema": "inventory_warehouse",
			"key_map": { "warehouse_id": "id" },
			"on_delete": "SET NULL"
		},
		{
			"edge": "storage_category",
			"label": { "en-US": "Storage category" },
			"type": "many:one",
			"dest_schema": "inventory_storage_category",
			"key_map": { "storage_category_id": "id" },
			"on_delete": "NO ACTION"
		}
	]
}
