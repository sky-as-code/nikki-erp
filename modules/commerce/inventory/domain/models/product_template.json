{
	"name": "inventory_product_template",
	"label": "inventory_product_template.label",
	"table_name": "inventory_product_templates",
	"should_build_db": true,
	"record_label_field": "name",
	"default_search_fields": ["name", "category_name", "uom_name", "base_sales_price", "status"],
	"partial_uniques_strict": [
		{ "index_name": "invty_prod_tpls_tid_src_sys_ext_id", "not_null_fields": ["source_system"], "nullable_field": "external_id" }
	],
	"extend_before": ["core.basemodel.base_model"],

	"fields": [
		{
			"name": "name",
			"label": "fields.name",
			"data_type": { "type": "langjson", "min": 1, "max": 200 },
			"required_for_create": true
		},
		{
			"name": "short_name",
			"label": "fields.short_name",
			"data_type": { "type": "langjson", "min": 0, "max": 100 },
			"description": "field_desc.inventory_product_template.short_name"
		},
		{
			"name": "product_type",
			"label": "fields.product_type",
			"data_type": {
				"type": "enum_string",
				"values": ["goods", "service"]
			},
			"required_for_create": true,
			"default_value": "goods",
			"description": "field_desc.inventory_product_template.product_type"
		},
		{
			"name": "is_combo",
			"label": "fields.is_combo",
			"data_type": "boolean",
			"default_value": false,
			"description": "field_desc.inventory_product_template.is_combo"
		},
		{
			"name": "category_id",
			"label": "fields.category_id",
			"data_type": "ulid",
			"required_for_create": true,
			"description": "field_desc.inventory_product_template.category_id"
		},
		{
			"name": "brand_id",
			"label": "fields.brand_id",
			"data_type": "ulid",
			"description": "field_desc.inventory_product_template.brand_id"
		},
		{
			"name": "uom_id",
			"label": "fields.uom_id",
			"data_type": "ulid",
			"description": "field_desc.inventory_product_template.uom_id"
		},
		{
			"name": "sale_ok",
			"label": "fields.sale_ok",
			"data_type": "boolean",
			"default_value": true,
			"description": "field_desc.inventory_product_template.sale_ok"
		},
		{
			"name": "purchase_ok",
			"label": "fields.purchase_ok",
			"data_type": "boolean",
			"default_value": true,
			"description": "field_desc.inventory_product_template.purchase_ok"
		},
		{
			"name": "description",
			"label": "fields.description",
			"data_type": { "type": "string", "min": 0, "max": 4000 }
		},
		{
			"name": "sales_description",
			"label": "fields.sales_description",
			"data_type": { "type": "string", "min": 0, "max": 4000 },
			"description": "field_desc.inventory_product_template.sales_description"
		},
		{
			"name": "purchase_description",
			"label": "fields.purchase_description",
			"data_type": { "type": "string", "min": 0, "max": 4000 },
			"description": "field_desc.inventory_product_template.purchase_description"
		},
		{
			"name": "preview_image_file_id",
			"label": "fields.preview_image_file_id",
			"data_type": "ulid",
			"metadata": { "file_field": true },
			"description": "field_desc.inventory_product_template.preview_image_file_id"
		},
		{
			"name": "base_sales_price",
			"label": "fields.base_sales_price",
			"data_type": { "type": "decimal", "min": "0", "max": "1000000000000", "scale": 6 },
			"default_value": "0",
			"description": "field_desc.inventory_product_template.base_sales_price"
		},
		{
			"name": "default_weight",
			"label": "fields.default_weight",
			"data_type": { "type": "decimal", "min": "0", "max": "1000000000000", "scale": 6 },
			"description": "field_desc.inventory_product_template.default_weight"
		},
		{
			"name": "default_length",
			"label": "fields.default_length",
			"data_type": { "type": "decimal", "min": "0", "max": "1000000000000", "scale": 6 },
			"description": "field_desc.inventory_product_template.default_length"
		},
		{
			"name": "default_width",
			"label": "fields.default_width",
			"data_type": { "type": "decimal", "min": "0", "max": "1000000000000", "scale": 6 },
			"description": "field_desc.inventory_product_template.default_width"
		},
		{
			"name": "default_height",
			"label": "fields.default_height",
			"data_type": { "type": "decimal", "min": "0", "max": "1000000000000", "scale": 6 },
			"description": "field_desc.inventory_product_template.default_height"
		},
		{
			"name": "status",
			"label": "fields.status",
			"data_type": {
				"type": "enum_string",
				"values": ["draft", "active", "discontinued"]
			},
			"required_for_create": true,
			"default_value": "draft"
		},
		{
			"name": "source_system",
			"label": "fields.source_system",
			"data_type": { "type": "string", "min": 1, "max": 50 },
			"required_for_create": true,
			"default_value": "manual",
			"description": "field_desc.inventory_product_template.source_system"
		},
		{
			"name": "external_id",
			"label": "fields.external_id",
			"data_type": { "type": "string", "min": 1, "max": 200 },
			"description": "field_desc.inventory_product_template.external_id"
		},
		{
			"name": "org_id",
			"label": "fields.org_id",
			"data_type": "ulid",
			"required_for_create": true
		},
		{
			"name": "category_name",
			"label": "fields.category_name",
			"data_type": { "type": "langjson", "min": 0, "max": 200 },
			"computed": { "kind": "related", "is_stored": false, "field": "category.name" },
			"description": "field_desc.inventory_product_template.category_name"
		},
		{
			"name": "uom_name",
			"label": "fields.uom_name",
			"data_type": { "type": "langjson", "min": 0, "max": 200 },
			"computed": { "kind": "related", "is_stored": false, "field": "uom.name" },
			"description": "field_desc.inventory_product_template.uom_name"
		},
		{
			"name": "variant_count",
			"label": "fields.variant_count",
			"data_type": { "type": "int64", "min": 0, "max": 1000000000 },
			"computed": {
				"kind": "aggregate",
				"is_stored": false,
				"source": "variants",
				"function": "count"
			},
			"description": "field_desc.inventory_product_template.variant_count"
		},
		{
			"name": "min_variant_cost",
			"label": "fields.min_variant_cost",
			"data_type": { "type": "decimal", "min": "0", "max": "1000000000000", "scale": 6 },
			"computed": {
				"kind": "aggregate",
				"is_stored": false,
				"source": "variants",
				"function": "min",
				"field": "cost"
			},
			"description": "field_desc.inventory_product_template.min_variant_cost"
		},
		{
			"name": "max_variant_cost",
			"label": "fields.max_variant_cost",
			"data_type": { "type": "decimal", "min": "0", "max": "1000000000000", "scale": 6 },
			"computed": {
				"kind": "aggregate",
				"is_stored": false,
				"source": "variants",
				"function": "max",
				"field": "cost"
			},
			"description": "field_desc.inventory_product_template.max_variant_cost"
		},
		{
			"name": "attribute_configuration",
			"label": "fields.attribute_configuration",
			"data_type": "jsonmap",
			"computed": { "kind": "function", "is_stored": false, "function": "inventory.template_attribute_configuration" },
			"description": "field_desc.inventory_product_template.attribute_configuration"
		}
	],

	"extend_after": [
		"core.basemodel.archivable_model",
		"core.basemodel.auditable_model",
		"core.basemodel.traceable_model",
		"core.basemodel.versioned_model"
	],

	"edges_to": [
		{
			"edge": "category",
			"label": { "en-US": "Category" },
			"type": "many:one",
			"dest_schema": "inventory_product_category",
			"key_map": { "category_id": "id" },
			"on_delete": "NO ACTION"
		},
		{
			"edge": "brand",
			"label": { "en-US": "Brand" },
			"type": "many:one",
			"dest_schema": "inventory_brand",
			"key_map": { "brand_id": "id" },
			"on_delete": "NO ACTION"
		},
		{
			"edge": "uom",
			"label": { "en-US": "Unit of measure" },
			"type": "many:one",
			"dest_schema": "essential_uom",
			"key_map": { "uom_id": "id" },
			"on_delete": "NO ACTION"
		}
	],

	"edges_from": [
		{
			"edge": "variants",
			"label": { "en-US": "Variants" },
			"existing": { "src_schema": "inventory_product_variant", "src_edge": "product_template" }
		},
		{
			"edge": "attribute_lines",
			"label": { "en-US": "Attribute lines" },
			"existing": { "src_schema": "inventory_product_template_attribute", "src_edge": "template" }
		},
		{
			"edge": "exclusions",
			"label": { "en-US": "Combination exclusions" },
			"existing": { "src_schema": "inventory_product_template_combination_exclusion", "src_edge": "template" }
		}
	]
}
