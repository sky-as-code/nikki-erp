			"data_type": { "type": "decimal", "min": "-1000000000000", "max": "1000000000000", "scale": 6 },
			"description": "field_desc.inventory_stock_move.remaining_quantity"
		},
		{
			"name": "remaining_value",
			"label": "fields.remaining_value",
			"data_type": { "type": "decimal", "min": "-1000000000000", "max": "1000000000000", "scale": 6 },
			"description": "field_desc.inventory_stock_move.remaining_value"
		},
		{
			"name": "currency_id",
			"label": "fields.currency_id",
			"data_type": "ulid",
			"description": "field_desc.inventory_stock_move.currency_id"
		},
		{
			"name": "source_item_id",
			"label": "fields.source_item_id",
			"data_type": "ulid",
