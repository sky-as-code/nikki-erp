{
	"name": "inventory_stock_move",
	"label": "inventory_stock_move.label",
	"table_name": "inventory_stock_moves",
	"should_build_db": true,
	"default_search_fields": ["sequence", "demand_quantity", "status"],
	"extend_before": ["core.basemodel.base_model"],

	"fields": [
		{
			"name": "transfer_id",
			"label": "fields.transfer_id",
			"data_type": "ulid",
			"no_update": true,
			"description": "field_desc.inventory_stock_move.transfer_id"
		},
		{
			"name": "sequence",
			"label": "fields.sequence",
			"data_type": { "type": "int32", "min": 0, "max": 2147483647 },
