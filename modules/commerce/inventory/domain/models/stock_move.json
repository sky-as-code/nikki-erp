			"label": { "en-US": "Source location" },
			"type": "many:one",
			"dest_schema": "inventory_location",
			"key_map": { "source_location_id": "id" },
			"on_delete": "NO ACTION"
		},
		{
			"edge": "destination_location",
			"label": { "en-US": "Destination location" },
			"type": "many:one",
			"dest_schema": "inventory_location",
			"key_map": { "destination_location_id": "id" },
			"on_delete": "NO ACTION"
		},
		{
			"edge": "uom",
			"label": { "en-US": "Unit of measure" },
			"type": "many:one",
			"dest_schema": "essential_uom",
			"key_map": { "uom_id": "id" },
			"on_delete": "SET NULL"
		}
	]
