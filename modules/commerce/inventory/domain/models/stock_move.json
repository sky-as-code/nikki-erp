			"description": "field_desc.inventory_stock_move.sequence"
		},
		{
			"name": "product_variant_id",
			"label": "fields.product_variant_id",
			"data_type": "ulid",
			"required_for_create": true,
			"no_update": true,
			"description": "field_desc.inventory_stock_move.product_variant_id"
		},
		{
			"name": "uom_id",
			"label": "fields.uom_id",
			"data_type": "ulid",
			"description": "field_desc.inventory_stock_move.uom_id"
		},
		{
			"name": "demand_quantity",
			"label": "fields.demand_quantity",
			"data_type": { "type": "decimal", "min": "0", "max": "1000000000000", "scale": 6 },
			"required_for_create": true,
			"description": "field_desc.inventory_stock_move.demand_quantity"
		},
		{
			"name": "base_demand_quantity",
			"label": "fields.base_demand_quantity",
			"data_type": { "type": "decimal", "min": "0", "max": "1000000000000", "scale": 6 },
			"required_for_create": true,
			"description": "field_desc.inventory_stock_move.base_demand_quantity"
		},
		{
			"name": "source_location_id",
			"label": "fields.source_location_id",
			"data_type": "ulid",
			"required_for_create": true,
			"description": "field_desc.inventory_stock_move.source_location_id"
		},
		{
			"name": "destination_location_id",
			"label": "fields.destination_location_id",
			"data_type": "ulid",
			"required_for_create": true,
			"description": "field_desc.inventory_stock_move.destination_location_id"
		},
		{
			"name": "final_location_id",
			"label": "fields.final_location_id",
			"data_type": "ulid",
			"description": "field_desc.inventory_stock_move.final_location_id"
		},
		{
