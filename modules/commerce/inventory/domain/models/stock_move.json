			"data_type": {
				"type": "enum_string",
				"values": ["draft", "waiting", "confirmed", "partially_available", "assigned", "done", "cancelled"]
			},
			"required_for_create": true,
			"default_value": "draft",
			"no_update": true
		},
		{
			"name": "priority",
			"label": "fields.priority",
			"data_type": { "type": "int32", "min": 0, "max": 100 },
			"default_value": 0,
			"description": "field_desc.inventory_stock_move.priority"
		},
		{
			"name": "scheduled_at",
			"label": "fields.scheduled_at",
