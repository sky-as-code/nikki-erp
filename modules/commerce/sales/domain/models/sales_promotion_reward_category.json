{
	"name": "sales_promotion_reward_category",
	"label": "sales_promotion_reward_category.label",
	"table_name": "sales_promotion_reward_categories",
	"should_build_db": true,
	"composite_uniques": [
		{ "index_name": "sls_promo_rwd_cats_tid_rwd_cat", "fields": ["reward_id", "category_id"] }
	],
	"search_indexes": [{ "index_name": "sls_promo_rwd_cats_tid_cat", "fields": ["category_id"] }],
	"extend_before": ["core.basemodel.base_model", "core.basemodel.org_base_model"],

	"fields": [
		{
			"name": "reward_id",
			"label": "fields.reward_id",
			"data_type": "ulid",
			"required_for_create": true,
			"no_update": true,
			"description": { "en-US": "The reward this category selector narrows. Written only through the reward's manage_categories action." }
		},
		{
			"name": "category_id",
			"label": "fields.category_id",
			"data_type": "ulid",
			"required_for_create": true,
			"no_update": true,
			"description": { "en-US": "Matches products of this category and of every category beneath it (BR-C03)." }
		}
	],

	"extend_after": ["core.basemodel.auditable_model", "core.basemodel.traceable_model"],

	"edges_to": [
		{
			"edge": "reward",
			"label": { "en-US": "Reward" },
			"type": "many:one",
			"dest_schema": "sales_promotion_reward",
			"key_map": { "reward_id": "id" },
			"on_delete": "CASCADE"
		},
		{
			"edge": "category",
			"label": { "en-US": "Product category" },
			"type": "many:one",
			"dest_schema": "inventory_product_category",
			"key_map": { "category_id": "id" },
			"on_delete": "RESTRICT"
		}
	]
}
