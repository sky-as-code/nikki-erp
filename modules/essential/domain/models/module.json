{
	"name": "essential_module_metadata",
	"label": "essential_module_metadata.label",
	"table_name": "essential_modules",
	"should_build_db": true,
	"composite_uniques": [
		{
			"fields": [
				"name"
			]
		}
	],
	"fields": [
		{
			"name": "id",
			"label": "fields.id",
			"data_type": "ulid",
			"primary_key": true,
			"use_type_default": true,
			"description": {
				"en-US": "Declared here rather than inherited from core.basemodel.base_model, because that mixin carries the tenant key in the hosted app and module metadata is global: it is synced once at start-up with no tenant in scope."
			}
		},
		{
			"name": "name",
			"label": "fields.name",
			"data_type": {
				"type": "string",
				"min": 1,
				"max": 50
			},
			"required_for_create": true
		},
		{
			"name": "label",
			"label": "fields.label",
			"data_type": {
				"type": "langjson",
				"min": 1,
				"max": 50
			},
			"required_for_create": true
		},
		{
			"name": "is_orphaned",
			"label": "fields.is_orphaned",
			"data_type": "boolean",
			"required_for_create": true,
			"default_value": false
		},
		{
			"name": "is_internal",
			"label": "fields.is_internal",
			"data_type": "boolean",
			"required_for_create": true,
			"no_update": true
		},
		{
			"name": "version",
			"label": "fields.version",
			"data_type": {
				"type": "string",
				"min": 1,
				"max": 50
			},
			"required_for_create": true
		},
		{
			"name": "has_ui",
			"label": "fields.has_ui",
			"data_type": "boolean",
			"required_for_create": true,
			"default_value": false
		},
		{
			"name": "model_prefix",
			"label": "fields.model_prefix",
			"data_type": {
				"type": "string",
				"min": 1,
				"max": 50
			}
		},
		{
			"name": "category",
			"label": "fields.category",
			"data_type": {
				"type": "enum_string",
				"values": [
					"foundation",
					"coremart",
					"coreparking",
					"itinfra"
				]
			}
		},
		{
			"name": "is_enabled",
			"label": "fields.is_enabled",
			"data_type": "boolean",
			"required_for_create": true,
			"no_update": true,
			"default_value": true
		},
		{
			"name": "dependencies",
			"label": "fields.dependencies",
			"data_type": { "type": "string", "array": true, "min": 1, "max": 50 },
			"description": {
				"en-US": "Names of the modules this one depends on, as its Deps() declared at the last boot."
			}
		},
		{
			"name": "dep_level",
			"label": "fields.dep_level",
			"data_type": { "type": "int32", "min": 0, "max": 999 },
			"required_for_create": true,
			"default_value": "0",
			"description": {
				"en-US": "Depth in the dependency graph of the loaded modules: 0 depends on no loaded module, otherwise one more than its deepest dependency. Org lifecycle commands are sent level by level."
			}
		}
	],
	"extend_after": [
		"core.basemodel.versioned_model",
		"core.basemodel.auditable_model"
	]
}
