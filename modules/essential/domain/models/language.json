{
	"name": "essential_language",
	"label": "essential_language.label",
	"table_name": "essential_languages",
	"should_build_db": true,
	"default_search_fields": ["name", "locale_code", "direction", "is_enabled"],
	"extend_before": [
		"core.basemodel.base_model"
	],
	"fields": [
		{
			"name": "name",
			"label": "fields.name",
			"data_type": {
				"type": "string",
				"min": 1,
				"max": 200
			},
			"required_for_create": true,
			"unique": true
		},
		{
			"name": "locale_code",
			"label": "fields.locale_code",
			"data_type": {
				"type": "string",
				"min": 5,
				"max": 10,
				"regex": "^[a-z]{2}-[A-Z]{2}$"
			},
			"required_for_create": true,
			"unique": true
		},
		{
			"name": "direction",
			"label": "fields.direction",
			"data_type": {
				"type": "enum_string",
				"values": [
					"ltr",
					"rtl"
				]
			},
			"required_for_create": true,
			"default_value": "ltr"
		},
		{
			"name": "decimal_separator",
			"label": "fields.decimal_separator",
			"data_type": {
				"type": "string",
				"min": 1,
				"max": 5
			},
			"required_for_create": true,
			"default_value": "."
		},
		{
			"name": "thousands_separator",
			"label": "fields.thousands_separator",
			"data_type": {
				"type": "string",
				"min": 0,
				"max": 5
			},
			"default_value": ","
		},
		{
			"name": "grouping",
			"label": "fields.grouping",
			"data_type": {
				"type": "string",
				"min": 2,
				"max": 30
			},
			"required_for_create": true,
			"default_value": "[3,0]"
		},
		{
			"name": "date_format",
			"label": "fields.date_format",
			"data_type": {
				"type": "string",
				"min": 1,
				"max": 30
			},
			"required_for_create": true,
			"default_value": "%m/%d/%Y"
		},
		{
			"name": "time_format",
			"label": "fields.time_format",
			"data_type": {
				"type": "string",
				"min": 1,
				"max": 30
			},
			"required_for_create": true,
			"default_value": "%H:%M:%S"
		},
		{
			"name": "short_time_format",
			"label": "fields.short_time_format",
			"data_type": {
				"type": "string",
				"min": 1,
				"max": 30
			},
			"required_for_create": true,
			"default_value": "%H:%M"
		},
		{
			"name": "first_day_of_week",
			"label": "fields.first_day_of_week",
			"data_type": {
				"type": "enum_string",
				"values": [
					"monday",
					"tuesday",
					"wednesday",
					"thursday",
					"friday",
					"saturday",
					"sunday"
				]
			},
			"required_for_create": true,
			"default_value": "sunday"
		},
		{
			"name": "is_enabled",
			"label": "fields.is_enabled",
			"data_type": "boolean",
			"default_value": false
		}
	],
	"extend_after": [
		"core.basemodel.versioned_model",
		"core.basemodel.auditable_model",
		"core.basemodel.traceable_model"
	]
}
