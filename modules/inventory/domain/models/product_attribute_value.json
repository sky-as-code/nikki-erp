{
	"name": "inventory_product_attribute_value",
	"label": "inventory_product_attribute_value.label",
	"table_name": "inventory_product_attribute_values",
	"should_build_db": true,
	"record_label_field": "name",
	"default_search_fields": ["code", "name", "sequence", "price_extra"],
	"composite_uniques": [{ "index_name": "invty_prod_attr_vals_tid_attr_id_code", "fields": ["attribute_id", "code"] }],
	"extend_before": ["core.basemodel.base_model"],

	"fields": [
		{
			"name": "attribute_id",
			"label": "fields.attribute_id",
			"data_type": "ulid",
			"required_for_create": true,
			"description": {
				"en-US": "The attribute this value belongs to. A value cannot exist outside an attribute."
			}
		},
		{
			"name": "code",
			"label": "fields.code",
			"data_type": { "type": "string", "min": 1, "max": 50 },
			"required_for_create": true
		},
		{
			"name": "name",
			"label": "fields.name",
			"data_type": { "type": "langjson", "min": 1, "max": 200 },
			"required_for_create": true
		},
		{
			"name": "sequence",
			"label": "fields.sequence",
			"data_type": { "type": "int32", "min": 0, "max": 2147483647 }
		},
		{
			"name": "price_extra",
			"label": "fields.price_extra",
			"data_type": { "type": "decimal", "min": "-1000000000000", "max": "1000000000000", "scale": 6 },
			"description": {
				"en-US": "DEPRECATED as a pricing input, and no longer authoritative. Kept because existing rows hold values a deployment may still want to read, and dropping a column loses them irrecoverably.\n\nA surcharge belongs to Template × Attribute × Value, not to the attribute value alone: the same value surcharges differently on different products, and one global number cannot say so (BR-PRICE-VARIANT-002). The field that counts is inventory_product_template_attribute_value.sales_price_extra, and it is the only one effective_base_sales_price reads. Do not write new pricing here and do not read this for pricing."
			}
		},
		{
			"name": "org_id",
			"label": "fields.org_id",
			"data_type": "ulid",
			"required_for_create": true
		}
	],

	"extend_after": [
		"core.basemodel.archivable_model",
		"core.basemodel.auditable_model",
		"core.basemodel.versioned_model"
	],

	"edges_to": [
		{
			"edge": "attribute",
			"label": { "en-US": "Attribute" },
			"type": "many:one",
			"dest_schema": "inventory_product_attribute",
			"key_map": { "attribute_id": "id" },
			"on_delete": "NO ACTION"
		}
	]
}
