{
	"name": "inventory_product_category",
	"label": "inventory_product_category.label",
	"table_name": "inventory_product_categories",
	"should_build_db": true,
	"record_label_field": "name",
	"default_search_fields": ["code", "name", "sequence"],
	"composite_uniques": [{ "fields": ["code", "org_id"] }],
	"partial_uniques_strict": [
		{ "index_name": "invty_prod_cats_tid_src_sys_ext_id", "not_null_fields": ["source_system"], "nullable_field": "external_id" }
	],
	"extend_before": ["core.basemodel.base_model"],

	"fields": [
		{
			"name": "code",
			"label": "fields.code",
			"data_type": { "type": "string", "min": 1, "max": 50 },
			"required_for_create": true
		},
		{
			"name": "name",
			"label": "fields.name",
			"data_type": { "type": "langjson", "min": 1, "max": 200 },
			"required_for_create": true
		},
		{
			"name": "parent_category_id",
			"label": "fields.parent_category_id",
			"data_type": "ulid",
			"description": {
				"en-US": "Parent in the category tree. Null for a root category. The tree must stay acyclic, which the engine enforces because the schema cannot."
			}
		},
		{
			"name": "sequence",
			"label": "fields.sequence",
			"data_type": { "type": "int32", "min": 0, "max": 2147483647 },
			"description": {
				"en-US": "Display order among siblings."
			}
		},
		{
			"name": "description",
			"label": "fields.description",
			"data_type": { "type": "langjson", "min": 0, "max": 2000 }
		},
		{
			"name": "source_system",
			"label": "fields.source_system",
			"data_type": { "type": "string", "min": 1, "max": 50 },
			"required_for_create": true,
			"default_value": "manual",
			"description": {
				"en-US": "Which system the record originates from: 'manual' for records entered through the UI, 'import' for rows loaded from a file, or an external system's own code. Together with external_id it is the key an import uses to recognise a record it has written before."
			}
		},
		{
			"name": "external_id",
			"label": "fields.external_id",
			"data_type": { "type": "string", "min": 1, "max": 200 },
			"description": {
				"en-US": "The record's identifier in its source system. Optional; unique per tenant together with source_system when present, which is the database's last defence against importing one record twice."
			}
		},
		{
			"name": "org_id",
			"label": "fields.org_id",
			"data_type": "ulid",
			"required_for_create": true
		}
	],

	"extend_after": [
		"core.basemodel.archivable_model",
		"core.basemodel.auditable_model",
		"core.basemodel.versioned_model"
	],

	"edges_to": [
		{
			"edge": "parent_category",
			"label": { "en-US": "Parent category" },
			"type": "many:one",
			"dest_schema": "inventory_product_category",
			"key_map": { "parent_category_id": "id" },
			"on_delete": "NO ACTION"
		}
	]
}
