{
	"name": "inventory_stock_move",
	"label": "inventory_stock_move.label",
	"table_name": "inventory_stock_moves",
	"should_build_db": true,
	"extend_before": ["core.basemodel.base_model"],

	"fields": [
		{
			"name": "transfer_id",
			"label": "fields.transfer_id",
			"data_type": "ulid",
			"no_update": true,
			"description": {
				"en-US": "The transfer this move belongs to. Optional, because a system move — an inventory adjustment or a scrap — has no transfer header (BR 4.2.4.2)."
			}
		},
		{
			"name": "sequence",
			"label": "fields.sequence",
			"data_type": { "type": "int32", "min": 0, "max": 2147483647 },
			"default_value": 0,
			"description": {
				"en-US": "Display order within the transfer. Presentation only; it does not affect processing order."
			}
		},
		{
			"name": "product_variant_id",
			"label": "fields.product_variant_id",
			"data_type": "ulid",
			"required_for_create": true,
			"no_update": true,
			"description": {
				"en-US": "A move is always for a concrete variant, never a template: a template alone does not identify a physical article (BR 3.1)."
			}
		},
		{
			"name": "uom_id",
			"label": "fields.uom_id",
			"data_type": "ulid",
			"description": {
				"en-US": "The unit demand_quantity is expressed in, which may differ from the variant's base unit."
			}
		},
		{
			"name": "demand_quantity",
			"label": "fields.demand_quantity",
			"data_type": { "type": "decimal", "min": "0", "max": "1000000000000", "scale": 6 },
			"required_for_create": true,
			"description": {
				"en-US": "How much the move asks for, in uom_id. This is the business demand and is never rewritten to what was actually processed: a partial validate leaves it intact and puts the remainder on a backorder (STOCK-INV-020, AC-STOCK-008)."
			}
		},
		{
			"name": "base_demand_quantity",
			"label": "fields.base_demand_quantity",
			"data_type": { "type": "decimal", "min": "0", "max": "1000000000000", "scale": 6 },
			"required_for_create": true,
			"description": {
				"en-US": "demand_quantity converted to the variant's base unit. Stored rather than recomputed so that a later change to the conversion factor cannot restate a movement already recorded."
			}
		},
		{
			"name": "source_location_id",
			"label": "fields.source_location_id",
			"data_type": "ulid",
			"required_for_create": true
		},
		{
			"name": "destination_location_id",
			"label": "fields.destination_location_id",
			"data_type": "ulid",
			"required_for_create": true
		},
		{
			"name": "final_location_id",
			"label": "fields.final_location_id",
			"data_type": "ulid",
			"description": {
				"en-US": "Where the goods end up at the end of a multi-step chain, when destination_location_id is only this step's handover point (BR 7.7)."
			}
		},
		{
			"name": "status",
			"label": "fields.status",
			"data_type": {
				"type": "enum_string",
				"values": ["draft", "waiting", "confirmed", "partially_available", "assigned", "done", "cancelled"]
			},
			"required_for_create": true,
			"default_value": "draft",
			"no_update": true,
			"description": {
				"en-US": "System-managed, and derived from allocation rather than set: 'assigned' when reserved equals demand, 'partially_available' when some but not all is reserved, 'confirmed' when none is (BR 4.2.3.8)."
			}
		},
		{
			"name": "priority",
			"label": "fields.priority",
			"data_type": { "type": "int32", "min": 0, "max": 100 },
			"default_value": 0
		},
		{
			"name": "scheduled_at",
			"label": "fields.scheduled_at",
			"data_type": "datetime"
		},
		{
			"name": "deadline_at",
			"label": "fields.deadline_at",
			"data_type": "datetime"
		},
		{
			"name": "reservation_date",
			"label": "fields.reservation_date",
			"data_type": "datetime",
			"description": {
				"en-US": "When this move becomes eligible for automatic reservation under the 'before_scheduled_date' method."
			}
		},
		{
			"name": "picked",
			"label": "fields.picked",
			"data_type": "boolean",
			"default_value": false,
			"description": {
				"en-US": "Whether the goods have been physically gathered. Distinct from being reserved, which is only a claim on stock, and from being done, which is the recorded movement."
			}
		},
		{
			"name": "origin_move_id",
			"label": "fields.origin_move_id",
			"data_type": "ulid",
			"description": {
				"en-US": "The move this one was split from, or the preceding step in a chain."
			}
		},
		{
			"name": "is_inventory_adjustment",
			"label": "fields.is_inventory_adjustment",
			"data_type": "boolean",
			"default_value": false,
			"description": {
				"en-US": "Marks a move generated by a physical count rather than a transfer, so that adjustments can be reported apart from trade movements."
			}
		},
		{
			"name": "scrap_id",
			"label": "fields.scrap_id",
			"data_type": "ulid",
			"description": {
				"en-US": "The scrap document that generated this move. Declared now and written by the scrap phase."
			}
		},
		{
			"name": "valuation_value",
			"label": "fields.valuation_value",
			"data_type": { "type": "decimal", "min": "-1000000000000", "max": "1000000000000", "scale": 6 },
			"description": {
				"en-US": "Monetary value of the movement. Declared now and left unwritten until the valuation phase: adding these columns later would be a migration on a table already holding movement history."
			}
		},
		{
			"name": "remaining_quantity",
			"label": "fields.remaining_quantity",
			"data_type": { "type": "decimal", "min": "-1000000000000", "max": "1000000000000", "scale": 6 },
			"description": {
				"en-US": "Quantity of this incoming move not yet consumed by an outgoing one, for FIFO valuation. Unwritten until the valuation phase."
			}
		},
		{
			"name": "remaining_value",
			"label": "fields.remaining_value",
			"data_type": { "type": "decimal", "min": "-1000000000000", "max": "1000000000000", "scale": 6 },
			"description": {
				"en-US": "Monetary value of remaining_quantity. Unwritten until the valuation phase."
			}
		},
		{
			"name": "currency_id",
			"label": "fields.currency_id",
			"data_type": "ulid",
			"description": {
				"en-US": "Currency the valuation columns are expressed in. Unwritten until the valuation phase."
			}
		},
		{
			"name": "org_id",
			"label": "fields.org_id",
			"data_type": "ulid",
			"required_for_create": true,
			"no_update": true
		}
	],

	"search_indexes": [
		{ "index_name": "invty_stock_moves_trf_id_sequence", "fields": ["transfer_id", "sequence"] },
		{ "index_name": "invty_stock_moves_pvar_id_status", "fields": ["product_variant_id", "status"] },
		{ "index_name": "invty_stock_moves_status_sched_at", "fields": ["status", "scheduled_at"] },
		{ "index_name": "invty_stock_moves_origin_move_id", "fields": ["origin_move_id"] }
	],

	"extend_after": [
		"core.basemodel.auditable_model",
		"core.basemodel.versioned_model"
	],

	"edges_to": [
		{
			"edge": "transfer",
			"label": { "en-US": "Transfer" },
			"type": "many:one",
			"dest_schema": "inventory_stock_transfer",
			"key_map": { "transfer_id": "id" },
			"on_delete": "NO ACTION"
		},
		{
			"edge": "product_variant",
			"label": { "en-US": "Product variant" },
			"type": "many:one",
			"dest_schema": "inventory_product_variant",
			"key_map": { "product_variant_id": "id" },
			"on_delete": "NO ACTION"
		},
		{
			"edge": "source_location",
			"label": { "en-US": "Source location" },
			"type": "many:one",
			"dest_schema": "inventory_location",
			"key_map": { "source_location_id": "id" },
			"on_delete": "NO ACTION"
		},
		{
			"edge": "destination_location",
			"label": { "en-US": "Destination location" },
			"type": "many:one",
			"dest_schema": "inventory_location",
			"key_map": { "destination_location_id": "id" },
			"on_delete": "NO ACTION"
		}
	]
}
