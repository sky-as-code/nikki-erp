meta {
  name: Group - Update
  type: http
  seq: 2
}

patch {
  url: {{api_host}}/v1/iam/iam_group/{{group_id}}
  body: json
  auth: inherit
}

body:json {
  {
    "org_id": "{{org_id}}",
      "name": "{{$randomJobArea}} {{$randomCatchPhraseAdjective}}",
      "description": "{{$randomLoremParagraphs}}",
      "etag": "{{etag}}"
  }
}

script:post-response {
  const {etag} = res.getBody();
  etag && bru.setVar('etag', etag);
  
}

settings {
  encodeUrl: true
  timeout: 0
}
