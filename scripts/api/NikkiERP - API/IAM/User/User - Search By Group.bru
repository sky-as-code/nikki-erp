meta {
  name: User - Search By Group
  type: http
  seq: 6
}

get {
  url: {{api_host}}/v1/iam/users?graph={"if":["groups.id", "=", "{{group_id}}"]}&withGroups=true
  body: none
  auth: inherit
}

params:query {
  graph: {"if":["groups.id", "=", "{{group_id}}"]}
  withGroups: true
}

settings {
  encodeUrl: true
  timeout: 0
}
