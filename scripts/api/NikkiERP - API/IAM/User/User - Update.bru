meta {
  name: User - Update
  type: http
  seq: 2
}

patch {
  url: {{api_host}}/v1/iam/iam_user/{{user_id}}
  body: json
  auth: inherit
}

body:json {
  {
    "org_id": "{{org_id}}",
      "avatar_url": "{{$randomUrl}}/{{$randomWord}}.jpg",
      "display_name": "{{$randomFullName}}",
      "etag": "{{etag}}"
  }
  
}

script:post-response {
  const body = res.getBody();
  const { etag } = body;
  etag && bru.setVar('etag', etag);
}

settings {
  encodeUrl: true
  timeout: 0
}
