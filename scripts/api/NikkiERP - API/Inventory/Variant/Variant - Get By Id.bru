meta {
  name: Variant - Get By Id
  type: http
  seq: 3
}

get {
  url: {{api_host}}/v1/{{org_id}}/inventory/products/{{product_id}}/variants/{{variant_id}}
  body: none
  auth: inherit
}

vars:pre-request {
  variant_id: 01K5INV0000000000000000500
  org_id: 01JWNY20G23KD4RV5VWYABQYHD
  product_id: 01K5INV0000000000000000011
}

script:post-response {
  const { etag } = res.getBody();
  etag && bru.setVar('etag', etag);
}

settings {
  encodeUrl: true
  timeout: 0
}
