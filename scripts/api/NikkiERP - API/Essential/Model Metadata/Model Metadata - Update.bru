meta {
  name: Model Metadata - Update
  type: http
  seq: 5
}

put {
  url: {{api_host}}/v1/essential/model-metadata/{{model_metadata_id}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": {
      "en-US": "Updated Model {{$randomLoremWord}}"
    },
    "code_prefix": "MD",
    "code_last_seq": 0,
    "padding": 8,
    "etag": "{{model_metadata_etag}}"
  }
}

script:post-response {
  const { etag } = res.getBody();
  etag && bru.setVar('model_metadata_etag', etag);
}

settings {
  encodeUrl: true
  timeout: 0
}

