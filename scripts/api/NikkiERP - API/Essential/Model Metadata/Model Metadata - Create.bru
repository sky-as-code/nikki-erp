meta {
  name: Model Metadata - Create
  type: http
  seq: 1
}

post {
  url: {{api_host}}/v1/essential/model-metadata
  body: json
  auth: inherit
}

script:pre-request {
  const suffix = Math.random().toString(36).slice(2, 10);
  bru.setVar('model_metadata_code', `model_${suffix}`.replace(/[^a-zA-Z0-9_]/g, '_'));
}

body:json {
  {
    "name": {
      "en-US": "Model {{$randomLoremWord}}"
    },
    "code": "{{model_metadata_code}}",
    "code_prefix": "MD",
    "code_last_seq": 0,
    "padding": 8
  }
}

script:post-response {
  const { id, etag } = res.getBody();
  id && bru.setVar('model_metadata_id', id);
  etag && bru.setVar('model_metadata_etag', etag);
}

settings {
  encodeUrl: true
  timeout: 0
}

