meta {
  name: Module - Create
  type: http
  seq: 1
}

post {
  url: {{api_host}}/v1/essential/modules
  body: json
  auth: inherit
}

body:json {
  {
    "name": "test_module_{{$randomLoremSlug}}",
    "label": {
      "en-US": "Test module {{$randomLoremWord}}"
    },
    "is_orphaned": false,
    "version": "1.0.0"
  }
}

script:post-response {
  const { id, etag } = res.getBody();
  id && bru.setVar('module_id', id);
  etag && bru.setVar('module_etag', etag);
}

settings {
  encodeUrl: true
  timeout: 0
}

