meta {
  name: Language - Get By ID
  type: http
  seq: 2
}

get {
  url: {{api_host}}/v1/essential/languages/{{language_id}}
  body: none
  auth: inherit
}

script:post-response {
  const { etag } = res.getBody();
  etag && bru.setVar('language_etag', etag);
}

settings {
  encodeUrl: true
  timeout: 0
}

