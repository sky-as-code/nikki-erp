meta {
  name: Party - Update
  type: http
  seq: 3
}

put {
  url: {{api_host}}/v1/{{org_id}}/contacts/parties/{{party_id}}
  body: json
  auth: inherit
}

body:json {
  {
    "avatar_url": "{{party_avatar_url}}",
    "display_name": "{{party_display_name}}",
    "legal_name": "{{party_legal_name}}",
    "legal_address": "{{party_legal_address}}",
    "tax_id": "{{party_tax_id}}",
    "job_position": "{{party_job_position}}",
    "title": "{{party_title}}",
    "type": "{{party_type}}",
    "note": "{{party_note}}",
    "website": "{{party_website}}",
    "etag": "{{etag}}"
  }
}

vars:pre-request {
  org_id: 01JWNY20G23KD4RV5VWYABQYHD
  party_avatar_url: https://cdn.example.com/avatars/default.jpg
  party_display_name: Nguyen Van A
  party_legal_name: Nguyen Van A LLC
  party_legal_address: 100 Nguyen Hue, District 1, Ho Chi Minh City
  party_tax_id: 0312345678
  party_job_position: Sales Manager
  party_title: Mr.
  party_type: company
  party_note: Priority customer in Ho Chi Minh City.
  party_website: https://example.com
}

script:pre-request {
  const parties = [
    {
      avatar: "https://cdn.example.com/avatars/party-a.jpg",
      displayName: "Nguyen Van A",
      legalName: "Nguyen Van A LLC",
      legalAddress: "100 Nguyen Hue, District 1, Ho Chi Minh City",
      taxId: "0312345678",
      jobPosition: "Sales Manager",
      title: "Mr.",
      type: "company",
      note: "Updated profile for strategic account.",
      website: "https://nguyenvana.vn"
    },
    {
      avatar: "https://cdn.example.com/avatars/party-b.jpg",
      displayName: "Tran Thi B",
      legalName: "Tran Thi B Trading",
      legalAddress: "25 Tran Hung Dao, District 5, Ho Chi Minh City",
      taxId: "0312345679",
      jobPosition: "Purchasing Lead",
      title: "Ms.",
      type: "individual",
      note: "Updated contact profile for quarterly plan.",
      website: "https://tranthib.vn"
    },
    {
      avatar: "https://cdn.example.com/avatars/party-c.jpg",
      displayName: "Le Minh C",
      legalName: "Le Minh C Joint Stock Company",
      legalAddress: "12 Le Loi, Hai Chau, Da Nang",
      taxId: "0401234567",
      jobPosition: "Operations Director",
      title: "Mr.",
      type: "company",
      note: "Updated profile for central region operation.",
      website: "https://leminhc.vn"
    }
  ];
  
  const randomParty = parties[Math.floor(Math.random() * parties.length)];
  
  bru.setVar('party_avatar_url', randomParty.avatar || "https://cdn.example.com/avatars/default.jpg");
  bru.setVar('party_display_name', randomParty.displayName || "Nguyen Van A");
  bru.setVar('party_legal_name', randomParty.legalName || "Nguyen Van A LLC");
  bru.setVar('party_legal_address', randomParty.legalAddress || "100 Nguyen Hue, District 1, Ho Chi Minh City");
  bru.setVar('party_tax_id', randomParty.taxId || "0312345678");
  bru.setVar('party_job_position', randomParty.jobPosition || "Sales Manager");
  bru.setVar('party_title', randomParty.title || "Mr.");
  bru.setVar('party_type', randomParty.type || "company");
  bru.setVar('party_note', randomParty.note || "Updated profile for strategic account.");
  bru.setVar('party_website', randomParty.website || "https://example.com");
}

script:post-response {
  const { etag } = res.getBody() || {};
  etag && bru.setVar('etag', etag);
}

settings {
  encodeUrl: true
  timeout: 0
}
