meta {
  name: Party - Get by ID
  type: http
  seq: 2
}

get {
  url: {{api_host}}/v1/{{org_id}}/contacts/parties/{{party_id}}
  body: none
  auth: inherit
}

vars:pre-request {
  org_id: 01JWNY20G23KD4RV5VWYABQYHD
}

script:post-response {
  const { etag } = res.getBody() || {};
  etag && bru.setVar('etag', etag);
}

settings {
  encodeUrl: true
  timeout: 0
}
