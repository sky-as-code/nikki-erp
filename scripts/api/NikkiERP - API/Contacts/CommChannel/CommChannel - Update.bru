meta {
  name: CommChannel - Update
  type: http
  seq: 2
}

put {
  url: {{api_host}}/v1/{{org_id}}/contacts/parties/{{party_id}}/channels/{{channel_id}}
  body: json
  auth: inherit
}

body:json {
  {
    "type": "{{channel_type}}",
    "value": "{{channel_value}}",
    "note": "{{channel_note}}",
    "valueJson": {
      "numberStreet": "{{channel_street}}",
      "ward": "{{channel_ward}}",
      "district": "{{channel_district}}",
      "city": "{{channel_city}}",
      "country": "{{channel_country}}"
    },
    "etag": "{{etag}}"
  }
}

vars:pre-request {
  org_id: 01JWNY20G23KD4RV5VWYABQYHD
  channel_type: email
  channel_value: updated@example.com
  channel_note: Updated communication channel.
  channel_street: 297 An Duong Vuong
  channel_ward: Ward 3
  channel_district: District 5
  channel_city: Ho Chi Minh City
  channel_country: Viet Nam
}

script:pre-request {
  const channels = [
    {
      type: "phone",
      value: "+84908887766",
      note: "Updated hotline number.",
      address: { street: "15 Nguyen Du", ward: "Ward 7", district: "District 1", city: "Ho Chi Minh City", country: "Viet Nam" }
    },
    {
      type: "email",
      value: "accounting@partner.vn",
      note: "Updated accounting contact.",
      address: { street: "39 Mac Dinh Chi", ward: "Da Kao", district: "District 1", city: "Ho Chi Minh City", country: "Viet Nam" }
    },
    {
      type: "post",
      value: "Updated postal address",
      note: "Updated postal channel.",
      address: { street: "66 Nguyen Thi Minh Khai", ward: "Ward 6", district: "District 3", city: "Ho Chi Minh City", country: "Viet Nam" }
    }
  ];
  
  const randomChannel = channels[Math.floor(Math.random() * channels.length)];
  
  bru.setVar('channel_type', randomChannel.type || "email");
  bru.setVar('channel_value', randomChannel.value || "updated@example.com");
  bru.setVar('channel_note', randomChannel.note || "Updated communication channel.");
  bru.setVar('channel_street', randomChannel.address?.street || "297 An Duong Vuong");
  bru.setVar('channel_ward', randomChannel.address?.ward || "Ward 3");
  bru.setVar('channel_district', randomChannel.address?.district || "District 5");
  bru.setVar('channel_city', randomChannel.address?.city || "Ho Chi Minh City");
  bru.setVar('channel_country', randomChannel.address?.country || "Viet Nam");
}

script:post-response {
  const { etag } = res.getBody() || {};
  etag && bru.setVar('etag', etag);
}

settings {
  encodeUrl: true
  timeout: 0
}
