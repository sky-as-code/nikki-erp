meta {
  name: Party Search - Success (1 level criteria)
  type: http
  seq: 4
}

get {
  url: {{api_host}}/v1/contacts/contacts_party?graph={"if":["type", "=", "company"]}&org_id={{org_id}}
  body: none
  auth: inherit
}

params:query {
  org_id: {{org_id}}
  graph: {"if":["type", "=", "company"]}
}

settings {
  encodeUrl: true
}
