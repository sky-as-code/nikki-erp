meta {
  name: CommChannel Search - Success (No criteria, With paging)
  type: http
  seq: 3
}

get {
  url: {{api_host}}/v1/contacts/contacts_comm_channel?page=0&size=2&org_id={{org_id}}
  body: none
  auth: inherit
}

params:query {
  org_id: {{org_id}}
  page: 0
  size: 2
}

settings {
  encodeUrl: true
}
