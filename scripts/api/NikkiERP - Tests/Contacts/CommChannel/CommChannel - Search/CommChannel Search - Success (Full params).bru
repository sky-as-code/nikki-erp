meta {
  name: CommChannel Search - Success (Full params)
  type: http
  seq: 1
}

get {
  url: {{api_host}}/v1/contacts/contacts_comm_channel?page=0&size=2&graph={"if":["type", "=", "post"]}&org_id={{org_id}}
  body: none
  auth: inherit
}

params:query {
  org_id: {{org_id}}
  page: 0
  size: 2
  graph: {"if":["type", "=", "post"]}
}

settings {
  encodeUrl: true
}
