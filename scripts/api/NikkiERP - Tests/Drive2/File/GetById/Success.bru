meta {
  name: Success
  type: http
  seq: 1
}

get {
  url: {{api_host}}/v1/drive2/files/:drive_file_id
  body: none
  auth: inherit
}

params:path {
  drive_file_id: {{drive2_file_id}}
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("Status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Body is object", function() {
    expect(res.getBody()).to.be.an("object");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
