meta {
  name: Action Update - Success
  type: http
  seq: 1
}

patch {
  url: {{api_host}}/v1/iam/iam_action/{{action_id}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": { "en-US": "{{$randomVerb}}   {{$timestamp}}" },
    "description": "{{$randomLoremParagraphs}}",
    "etag": "{{etag}}"
  }
}

script:pre-request {
  const body = req.getBody();
  
  if (body.hasOwnProperty('code')) {
    body.name["en-US"] = bru.interpolate(body.name["en-US"]);
    body.code = body.name["en-US"].toLowerCase().replace(/\s+/g, "_");
    req.setBody(body);
  }
}

script:post-response {
  const pkg = require('./scripts/update-success');
  
  pkg.testUpdate(1);
  
}

settings {
  encodeUrl: true
  timeout: 0
}
