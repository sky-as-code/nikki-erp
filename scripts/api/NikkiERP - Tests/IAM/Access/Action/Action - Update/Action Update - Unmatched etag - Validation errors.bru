meta {
  name: Action Update - Unmatched etag - Validation errors
  type: http
  seq: 4
}

patch {
  url: {{api_host}}/v1/iam/iam_action/{{action_id}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": { "en-US": "{{$randomCatchPhraseAdjective}}" },
    "etag": "___________________"
  }
}

script:post-response {
  const pkg = require('./scripts/error-400-etag-unmatched');
  
  pkg.testUnmatchedEtag();
  
}

settings {
  encodeUrl: true
  timeout: 0
}
