meta {
  name: Action Create - Required fields - Success
  type: http
  seq: 1
}

post {
  url: {{api_host}}/v1/iam/resources/{{resource_id}}/actions
  body: json
  auth: inherit
}

body:json {
  {
    "name": { "en-US": "{{$randomVerb}}   {{$timestamp}}" },
    "code": "action_{{$timestamp}}"
  }
}

script:pre-request {
  const body = req.getBody();
  body.name["en-US"] = bru.interpolate(body.name["en-US"]);
  body.code = body.name["en-US"].toLowerCase().replace(/\s+/g, "_");
  req.setBody(body);
}

script:post-response {
  const pkg = require('./scripts/create-success');
  
  pkg.testCreate('action_id');
  
}

settings {
  encodeUrl: true
  timeout: 0
}
