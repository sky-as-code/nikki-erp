meta {
  name: Resource Search - Create test data - Loop 50
  type: http
  seq: 1
}

post {
  url: {{api_host}}/v1/iam/iam_group
  body: json
  auth: inherit
}

body:json {
  {
    "name": { "en-US": "{{$randomColor}} {{$randomWord}} {{$timestamp}}" },
    "code": "<Modified by Pre-request Script>",
    "description": "{{$randomLoremParagraphs}}",
    "max_scope": "domain",
    "min_scope": "private"
  }
}

script:pre-request {
  const body = req.getBody();
  body.name["en-US"] = bru.interpolate(body.name["en-US"]);
  body.code = body.name["en-US"].toLowerCase().replace(/\s/g, "_");
  req.setBody(body);
}

script:post-response {
  const pkg = require('./scripts/common-test-response');
  
  pkg.loopTestData(
    'Resource Search - Create test data - Loop 50',
    'Resource Search - No criteria, No paging - Success',
  );
  
}

settings {
  encodeUrl: true
  timeout: 0
}
