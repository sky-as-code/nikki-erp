# NOTE: Copy this file and rename to .env.local

GENERAL_LOG_LEVEL=info

CORE_CQRS_REQUEST_TIMEOUT_SECS=3600

CORE_DB_USER=nikki_admin
CORE_DB_PASSWORD=nikki_password
CORE_DB_TLS_ENABLED=false
CORE_DB_ORM_DEBUG_ENABLED=true
CORE_DB_MAX_IDLE_CONNS=10
CORE_DB_MAX_OPEN_CONNS=100

CORE_EVENT_REDIS_PASSWORD=nikki_password

CORE_TOKEN_SECRET_KEY=your-secret-key-here-change-in-production
CORE_TOKEN_EXPIRY_HOURS=24

# OpenTelemetry. "none" keeps trace IDs and propagation without exporting anything.
OTEL_TRACES_EXPORTER=none
OTEL_TRACES_SAMPLER_ARG=1.0
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# CORE_TELEMETRY_PROPAGATION_HOST_ALLOWLIST=localhost
# CORE_TELEMETRY_BAGGAGE_ALLOWLIST=
